          "default": "100%"
        },
        {
          "type": "text",
          "id": "metric_title",
          "label": "Metric Title",
          "default": "Vegetarian & Cruelty-Free"
        },
        {
          "type": "textarea",
          "id": "metric_desc",
          "label": "Metric Description",
          "default": "PETA certified. Absolutely zero animal testing or animal by-products."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Ritual & Actives",
      "blocks": [
        { "type": "ingredient_card" },
        { "type": "ingredient_card" },
        { "type": "ingredient_card" },
        { "type": "ritual_step" },
        { "type": "ritual_step" },
        { "type": "ritual_step" },
        { "type": "purity_metric" },
        { "type": "purity_metric" },
        { "type": "purity_metric" },
        { "type": "purity_metric" }
      ]
