{% comment %}
  =============================================================================
  MYRA VEDA LUXURY ESSENTIALS - HAUTE LUXE BESPOKE CONTACT & CONCIERGE PAGE
  -----------------------------------------------------------------------------
  Features:
    - Haute Luxe Editorial Header with 24K Gold Eyebrow
    - 4 Direct Concierge Touchpoint Cards (WhatsApp, Email, Hours, Bespoke Gifting)
    - Dual-Column Layout:
        * Left: Luxury Contact Form with topic selector, floating fields & validation
        * Right: Client Care Promise & Fast-Track WhatsApp Concierge
    - Interactive Luxury FAQ Accordion with smooth transitions
    - 100% Theme Customizer Schema Editable (all texts, contact info, FAQs)
  =============================================================================
{% endcomment %}

<div class="mv-contact-section" id="mv-contact-{{ section.id }}" style="
  --mv-c-bg: {{ section.settings.background_color | default: '#FAF8F5' }};
  --mv-c-card-bg: {{ section.settings.card_background | default: '#FFFFFF' }};
  --mv-c-gold: {{ section.settings.accent_gold | default: '#C99E3E' }};
  --mv-c-dark: {{ section.settings.primary_text_color | default: '#112A20' }};
  --mv-c-muted: {{ section.settings.secondary_text_color | default: '#5C6B64' }};
  --mv-c-border: {{ section.settings.border_color | default: '#EAE4DC' }};
  --mv-c-pt: {{ section.settings.padding_top | default: 36 }}px;
  --mv-c-pb: {{ section.settings.padding_bottom | default: 48 }}px;
">
  <div class="mv-contact-container">
    
    <!-- 1. HAUTE LUXE EDITORIAL HEADER -->
    <header class="mv-contact-header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="mv-contact-eyebrow">
          <span class="mv-eyebrow-star">✦</span>
          <span class="mv-eyebrow-text">{{ section.settings.eyebrow | escape }}</span>
          <span class="mv-eyebrow-star">✦</span>
        </div>
      {%- endif -%}

      <h1 class="mv-contact-title">{{ section.settings.heading | default: "Connect With Myra Veda" | escape }}</h1>
      
      <div class="mv-contact-divider">
        <span class="mv-divider-line"></span>
        <span class="mv-divider-diamond">✦</span>
        <span class="mv-divider-line"></span>
      </div>

      {%- if section.settings.subheading != blank -%}
        <p class="mv-contact-subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </header>

    <!-- 2. CONCIERGE TOUCHPOINT CARDS (4-COL GRID) -->
    <div class="mv-touchpoints-grid">
      
      <!-- Card 1: WhatsApp & Direct Call -->
      <a href="https://wa.me/{{ section.settings.whatsapp_number | default: '919137254894' | remove: '+' | remove: '-' | remove: ' ' }}?text=Hello%20Myra%20Veda%20Concierge,%20I%20would%20like%20assistance%20with%20" target="_blank" rel="noopener" class="mv-touchpoint-card">
        <div class="mv-tp-icon-wrapper">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div class="mv-tp-info">
          <span class="mv-tp-tag">DIRECT CONCIERGE</span>
          <h3 class="mv-tp-title">{{ section.settings.phone_label | default: "WhatsApp & Call" | escape }}</h3>
          <p class="mv-tp-value">{{ section.settings.phone_number | default: "+91 91372 54894" | escape }}</p>
          <span class="mv-tp-action">Chat on WhatsApp &rarr;</span>
        </div>
      </a>

      <!-- Card 2: Client Care Email -->
      <a href="mailto:{{ section.settings.email_address | default: 'connect@myravedaluxury.com' }}" class="mv-touchpoint-card">
        <div class="mv-tp-icon-wrapper">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <div class="mv-tp-info">
          <span class="mv-tp-tag">ELECTRONIC CORRESPONDENCE</span>
          <h3 class="mv-tp-title">{{ section.settings.email_label | default: "Client Care Concierge" | escape }}</h3>
          <p class="mv-tp-value">{{ section.settings.email_address | default: "connect@myravedaluxury.com" | escape }}</p>
          <span class="mv-tp-action">Send Email &rarr;</span>
        </div>
      </a>

      <!-- Card 3: Operating Hours -->
      <div class="mv-touchpoint-card mv-tp-card-static">
        <div class="mv-tp-icon-wrapper">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div class="mv-tp-info">
          <span class="mv-tp-tag">CONCIERGE AVAILABILITY</span>
          <h3 class="mv-tp-title">{{ section.settings.hours_label | default: "Operating Hours" | escape }}</h3>
          <p class="mv-tp-value">{{ section.settings.hours_text | default: "Mon – Sat: 10:00 AM – 7:00 PM IST" | escape }}</p>
          <span class="mv-tp-sub">Sunday: Dedicated to Mindful Solitude</span>
        </div>
      </div>

      <!-- Card 4: Bespoke Gifting & Corporate PR -->
      <a href="mailto:{{ section.settings.gifting_email | default: 'connect@myravedaluxury.com' }}?subject=Bespoke%20Gifting%20%26%20Corporate%20Inquiry" class="mv-touchpoint-card">
        <div class="mv-tp-icon-wrapper">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 12 20 22 4 22 4 12"></polyline>
            <rect x="2" y="7" width="20" height="5"></rect>
            <line x1="12" y1="22" x2="12" y2="7"></line>
            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
          </svg>
        </div>
        <div class="mv-tp-info">
          <span class="mv-tp-tag">BESPOKE RITUALS</span>
          <h3 class="mv-tp-title">{{ section.settings.gifting_label | default: "Bespoke Gifting & PR" | escape }}</h3>
          <p class="mv-tp-value">{{ section.settings.gifting_subtitle | default: "Custom Hampers & Press" | escape }}</p>
          <span class="mv-tp-action">Inquire for Gifting &rarr;</span>
        </div>
      </a>

    </div>

    <!-- 3. DUAL-COLUMN LUXURY EXPERIENCE (FORM + CLIENT PROMISE) -->
    <div class="mv-contact-main-grid">
      
      <!-- LEFT COLUMN: LUXURY CONTACT FORM -->
      <div class="mv-form-wrapper">
        <div class="mv-form-header">
          <span class="mv-form-badge">RESERVATION & INQUIRY</span>
          <h2 class="mv-form-title">{{ section.settings.form_heading | default: "Send Us a Message" | escape }}</h2>
          <p class="mv-form-description">{{ section.settings.form_description | default: "Fill in the details below and our personal care advisors will respond within 24 business hours." | escape }}</p>
        </div>

        {%- form 'contact', id: 'ContactForm', class: 'mv-luxury-form' -%}
          
          {%- if form.posted_successfully? -%}
            <div class="mv-form-alert mv-form-success" role="status" tabindex="-1" autofocus>
              <div class="mv-alert-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              </div>
              <div class="mv-alert-content">
                <h4 class="mv-alert-title">Thank You For Connecting</h4>
                <p class="mv-alert-text">Your message has been received with warmth. An advisor from the Myra Veda concierge will respond to your registered email shortly.</p>
              </div>
            </div>
          {%- elsif form.errors -%}
            <div class="mv-form-alert mv-form-error" role="alert">
              <div class="mv-alert-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
              </div>
              <div class="mv-alert-content">
                <h4 class="mv-alert-title">Please Review Required Fields</h4>
                <p class="mv-alert-text">{{ form.errors | default_errors }}</p>
              </div>
            </div>
          {%- endif -%}

          <div class="mv-form-fields-grid">
            
            <!-- Inquiring About / Topic -->
            <div class="mv-field-group mv-field-full">
              <label for="ContactForm-Topic" class="mv-label">What can we assist you with?</label>
              <div class="mv-select-wrapper">
                <select id="ContactForm-Topic" name="contact[Inquiry Topic]" class="mv-select">
                  <option value="Order Tracking & Dispatch">Order Status & Tracking</option>
                  <option value="Botanical Ritual & Skincare Advice">Personalized Ritual & Skincare Advice</option>
                  <option value="Bespoke Gifting & Festive Hampers">Bespoke Gifting & Hampers</option>
                  <option value="Wholesale, Stockist & Distribution">Wholesale & Stockist Inquiries</option>
                  <option value="Press, Media & PR Collaborations">Press & Media Collaborations</option>
                  <option value="Other General Inquiries">Other Inquiries</option>
                </select>
                <span class="mv-select-arrow">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </div>
            </div>

            <!-- Full Name -->
            <div class="mv-field-group">
              <label for="ContactForm-Name" class="mv-label">Your Name <span class="mv-required">*</span></label>
              <input
                type="text"
                id="ContactForm-Name"
                name="contact[name]"
                class="mv-input"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="e.g. Maharani Devi"
                required
                autocomplete="name"
              >
            </div>

            <!-- Email Address -->
            <div class="mv-field-group">
              <label for="ContactForm-Email" class="mv-label">Email Address <span class="mv-required">*</span></label>
              <input
                type="email"
                id="ContactForm-Email"
                name="contact[email]"
                class="mv-input"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="e.g. client@domain.com"
                required
                spellcheck="false"
                autocapitalize="off"
                autocomplete="email"
              >
            </div>

            <!-- Contact Number -->
            <div class="mv-field-group">
              <label for="ContactForm-Phone" class="mv-label">Phone Number (Optional)</label>
              <input
                type="tel"
                id="ContactForm-Phone"
                name="contact[phone]"
                class="mv-input"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="+91 98765 43210"
                autocomplete="tel"
              >
            </div>

            <!-- Order Number -->
            <div class="mv-field-group">
              <label for="ContactForm-OrderNumber" class="mv-label">Order Number (If applicable)</label>
              <input
                type="text"
                id="ContactForm-OrderNumber"
                name="contact[Order Number]"
                class="mv-input"
                placeholder="e.g. #MV-10492"
              >
            </div>

            <!-- Detailed Message -->
            <div class="mv-field-group mv-field-full">
              <label for="ContactForm-Body" class="mv-label">Your Message <span class="mv-required">*</span></label>
              <textarea
                rows="5"
                id="ContactForm-Body"
                name="contact[body]"
                class="mv-textarea"
                placeholder="Tell us how we may assist your botanical journey..."
                required
              >{{ form.body }}</textarea>
            </div>

          </div>

          <!-- VIP Harvest Checkbox -->
          <div class="mv-checkbox-row">
            <label class="mv-checkbox-label">
              <input type="checkbox" name="contact[VIP Newsletter Opt-in]" value="Yes" checked class="mv-checkbox">
              <span class="mv-checkbox-custom"></span>
              <span class="mv-checkbox-text">Receive invitations to private botanical harvest releases, VIP preview rituals, and special privileges.</span>
            </label>
          </div>

          <!-- Submit Button -->
          <div class="mv-form-submit-row">
            <button type="submit" class="mv-btn-gold-submit">
              <span class="mv-btn-text">{{ section.settings.submit_label | default: "Send Message to Concierge" | escape }}</span>
              <span class="mv-btn-gold-arrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
              </span>
            </button>
          </div>

        {%- endform -%}
      </div>

      <!-- RIGHT COLUMN: CLIENT PROMISE & BRAND REASSURANCE -->
      <div class="mv-promise-column">
        
        <div class="mv-promise-card">
          <div class="mv-promise-badge">
            <span class="mv-pb-star">✦</span>
            <span>THE MYRA VEDA STANDARD</span>
            <span class="mv-pb-star">✦</span>
          </div>

          <h3 class="mv-promise-title">{{ section.settings.promise_heading | default: "A Symphony of Exotic Botanicals & Pure Ayurveda" | escape }}</h3>
          <p class="mv-promise-intro">{{ section.settings.promise_text | default: "Our client care team operates with the same meticulous mindfulness that guides our small-batch formulations." | escape }}</p>

          <div class="mv-promise-list">
            
            <div class="mv-promise-item">
              <div class="mv-pi-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C99E3E" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              </div>
              <div class="mv-pi-text">
                <h4>24-Hour Attentive Response</h4>
                <p>Every correspondence is reviewed by dedicated client advisors within 24 business hours.</p>
              </div>
            </div>

            <div class="mv-promise-item">
              <div class="mv-pi-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C99E3E" stroke-width="2.2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
              </div>
              <div class="mv-pi-text">
                <h4>Personalized Ritual Guidance</h4>
                <p>Curated botanical suggestions matched specifically to your unique dosha, skin type, and lifestyle.</p>
              </div>
            </div>

            <div class="mv-promise-item">
              <div class="mv-pi-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C99E3E" stroke-width="2.2"><path d="M11 20A7 7 0 0 1 4 13a8 8 0 0 1 8-8 7 7 0 0 1 7 7 8 8 0 0 1-8 8z"></path><path d="M12 2v20"></path></svg>
              </div>
              <div class="mv-pi-text">
                <h4>100% Genuine Artisanal Batches</h4>
                <p>Every bottle is ethically harvested, certified cruelty-free, and guaranteed authentic from source to soul.</p>
              </div>
            </div>

            <div class="mv-promise-item">
              <div class="mv-pi-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C99E3E" stroke-width="2.2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              </div>
              <div class="mv-pi-text">
                <h4>Sustainable Luxury Packaging</h4>
                <p>Recyclable glass, protective cushioned shipping, and conscious handling for pristine arrival.</p>
              </div>
            </div>

          </div>

          <!-- Fast-Track WhatsApp Banner inside Promise Card -->
          <div class="mv-promise-fasttrack">
            <div class="mv-fasttrack-content">
              <span class="mv-ft-badge">NEED INSTANT ANSWERS?</span>
              <h4 class="mv-ft-title">Chat with our Concierge</h4>
              <p class="mv-ft-desc">Available for immediate order inquiries, gifting advice, and ritual assistance.</p>
            </div>
            <a href="https://wa.me/{{ section.settings.whatsapp_number | default: '919137254894' | remove: '+' | remove: '-' | remove: ' ' }}?text=Hello%20Myra%20Veda%20Concierge,%20I%20need%20quick%20assistance" target="_blank" rel="noopener" class="mv-btn-whatsapp-pill">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="mv-btn-wa-svg">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>Instant WhatsApp</span>
            </a>
          </div>

        </div>

      </div>

    </div>

    <!-- 4. LUXURY FAQ ACCORDION SECTION ("INSTANT ANSWERS") -->
    {%- if section.blocks.size > 0 -%}
      <div class="mv-contact-faq-wrapper">
        <div class="mv-faq-header">
          <span class="mv-faq-badge">FREQUENTLY ASKED QUESTIONS</span>
          <h2 class="mv-faq-title">{{ section.settings.faq_heading | default: "Instant Answers to Frequent Inquiries" | escape }}</h2>
          <div class="mv-contact-divider mv-faq-divider">
            <span class="mv-divider-line"></span>
            <span class="mv-divider-diamond">✦</span>
            <span class="mv-divider-line"></span>
          </div>
        </div>

        <div class="mv-faq-accordion" data-allow-multiple="false">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              <div class="mv-faq-item {% if forloop.first %}is-open{% endif %}" {{ block.shopify_attributes }}>
                <button type="button" class="mv-faq-trigger" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="mv-faq-body-{{ block.id }}">
                  <span class="mv-faq-q-text">{{ block.settings.question | escape }}</span>
                  <span class="mv-faq-toggle-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                  </span>
                </button>
                <div class="mv-faq-body" id="mv-faq-body-{{ block.id }}" style="{% if forloop.first %}display: block;{% else %}display: none;{% endif %}">
                  <div class="mv-faq-content">
                    {{ block.settings.answer }}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  /* ==========================================================================
     MYRA VEDA HAUTE LUXE CONTACT PAGE - DESIGN SYSTEM & STYLES
     ========================================================================== */
  .mv-contact-section {
    background-color: var(--mv-c-bg, #FAF8F5);
    color: var(--mv-c-dark, #112A20);
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    position: relative;
    overflow: hidden;
    padding-top: var(--mv-c-pt, 36px);
    padding-bottom: var(--mv-c-pb, 48px);
  }

  .mv-contact-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.5vw, 40px);
  }

  /* --- 1. EDITORIAL HEADER --- */
  .mv-contact-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 28px auto;
  }

  .mv-contact-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--mv-c-gold, #C99E3E);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .mv-contact-title {
    font-family: var(--font-heading--family, 'Marcellus', 'Cinzel', serif);
    font-size: clamp(28px, 3.8vw, 44px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--mv-c-dark, #112A20);
    margin: 0 0 12px 0;
  }

  .mv-contact-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0 auto 12px auto;
    max-width: 180px;
  }

  .mv-divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--mv-c-gold, #C99E3E), transparent);
  }

  .mv-divider-diamond {
    color: var(--mv-c-gold, #C99E3E);
    font-size: 12px;
  }

  .mv-contact-subtitle {
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.6;
    color: var(--mv-c-muted, #5C6B64);
    margin: 0;
    font-weight: 400;
  }

  /* --- 2. CONCIERGE TOUCHPOINT CARDS --- */
  .mv-touchpoints-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }

  .mv-touchpoint-card {
    background: var(--mv-c-card-bg, #FFFFFF);
    border: 1px solid var(--mv-c-border, #EAE4DC);
