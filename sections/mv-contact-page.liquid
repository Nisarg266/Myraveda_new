<script>
  (function() {
    function initContactAccordion() {
      const section = document.getElementById('mv-contact-{{ section.id }}');
      if (!section) return;

      const items = section.querySelectorAll('.mv-faq-item');
      items.forEach(item => {
        const trigger = item.querySelector('.mv-faq-trigger');
        const body = item.querySelector('.mv-faq-body');
        if (!trigger || !body) return;

        trigger.onclick = function() {
          const isOpen = item.classList.contains('is-open');

          // Close other items if data-allow-multiple is false
          const container = item.closest('.mv-faq-accordion');
          if (container && container.getAttribute('data-allow-multiple') === 'false') {
            items.forEach(otherItem => {
              if (otherItem !== item) {
                otherItem.classList.remove('is-open');
                const otherTrigger = otherItem.querySelector('.mv-faq-trigger');
                const otherBody = otherItem.querySelector('.mv-faq-body');
                if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
                if (otherBody) otherBody.style.display = 'none';
              }
            });
          }

          if (isOpen) {
            item.classList.remove('is-open');
            trigger.setAttribute('aria-expanded', 'false');
            body.style.display = 'none';
          } else {
            item.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
            body.style.display = 'block';
          }
        };
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactAccordion);
    } else {
      initContactAccordion();
    }

    // Shopify Theme Customizer events
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initContactAccordion();
      }
    });
  })();
</script>

