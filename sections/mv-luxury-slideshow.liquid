{% render 'measure-header-heights' %}
{%- liquid
  assign d_height_css = 'calc(100vh - var(--header-group-height, var(--header-height, 100px)))'
  if section.settings.desktop_height_mode == 'custom'
    assign d_height_css = section.settings.desktop_height | default: 85 | append: 'vh'
  endif
-%}
<div class="mv-hero-slideshow" id="mv-slideshow-{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed | default: 6 }}" style="--hero-title-desktop: {{ section.settings.heading_size_desktop | default: 48 }}px; --hero-title-mobile: {{ section.settings.heading_size_mobile | default: 28 }}px; --hero-sub-desktop: {{ section.settings.subheading_size_desktop | default: 16 }}px; --hero-sub-mobile: {{ section.settings.subheading_size_mobile | default: 14 }}px; --hero-desktop-h: {{ d_height_css }}; --hero-mobile-h: {{ section.settings.mobile_height | default: 80 }}vh; padding-top: {{ section.settings.padding_top | default: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;">
  <div class="mv-slideshow-viewport">
    {%- for block in section.blocks -%}
      {%- assign is_first = forloop.first -%}
      {% liquid
        assign primary_link = block.settings.link
        if primary_link == blank
          assign primary_link = '#'
        endif

        assign secondary_url = block.settings.secondary_link
        if secondary_url == blank
          assign secondary_url = primary_link
        endif
      %}
      <div class="mv-hero-slide {% if is_first %}is-active{% endif %}" id="mv-slide-{{ block.id }}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <div class="mv-hero-media">
          {%- assign desktop_img = block.settings.image | default: block.settings.mobile_image -%}
          {%- assign mobile_img = block.settings.mobile_image | default: block.settings.image -%}

          {%- if desktop_img != blank -%}
            {%- liquid
              assign desktop_pos = 'center 65%'
              if block.settings.image_position != blank
                assign desktop_pos = block.settings.image_position
              elsif desktop_img.presentation.focal_point != blank
                assign desktop_pos = desktop_img.presentation.focal_point
              endif

              assign mobile_pos = 'center center'
              if block.settings.mobile_image_position != blank
                assign mobile_pos = block.settings.mobile_image_position
              elsif mobile_img.presentation.focal_point != blank
                assign mobile_pos = mobile_img.presentation.focal_point
              endif
            -%}
            <picture class="mv-hero-picture">
              {%- if mobile_img != blank -%}
                <source media="(max-width: 749px)" srcset="{{ mobile_img | image_url: width: 1000 }}">
              {%- endif -%}
              <img
                src="{{ desktop_img | image_url: width: 2400 }}"
                srcset="{{ desktop_img | image_url: width: 800 }} 800w, {{ desktop_img | image_url: width: 1400 }} 1400w, {{ desktop_img | image_url: width: 2200 }} 2200w"
                sizes="100vw"
                alt="{{ block.settings.title | default: 'Myra Veda Luxury Hero' | escape }}"
                loading="{% if is_first %}eager{% else %}lazy{% endif %}"
                class="mv-hero-bg-img"
                style="object-position: {{ desktop_pos }}; --img-pos-desktop: {{ desktop_pos }}; --img-pos-mobile: {{ mobile_pos }};"
              >
            </picture>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'mv-hero-placeholder' }}
          {%- endif -%}
          <div class="mv-hero-overlay"></div>
          {%- if primary_link != blank and primary_link != '#' -%}
            <a href="{{ primary_link }}" class="mv-hero-media-link" aria-label="{{ block.settings.title | default: 'Shop Product' | escape }}"></a>
          {%- endif -%}
        </div>

        <div class="mv-hero-container">
          <div class="mv-hero-content-wrapper mv-pos-{{ section.settings.content_alignment }}">
            <div class="mv-hero-editorial-content">
              <div class="mv-hero-eyebrow-slot">
                {%- if block.settings.caption != blank -%}
                  <div class="mv-hero-eyebrow">
                    <span class="mv-eyebrow-star">✦</span>
                    <span class="mv-eyebrow-text">{{ block.settings.caption | escape }}</span>
                    <span class="mv-eyebrow-star">✦</span>
                  </div>
                {%- endif -%}
              </div>

              <div class="mv-hero-title-slot">
                {%- if block.settings.title != blank -%}
                  {%- if primary_link != blank and primary_link != '#' -%}
                    <a href="{{ primary_link }}" class="mv-hero-title-anchor">
                      <h1 class="mv-hero-title">{{ block.settings.title | escape }}</h1>
                    </a>
                  {%- else -%}
                    <h1 class="mv-hero-title">{{ block.settings.title | escape }}</h1>
                  {%- endif -%}
                {%- endif -%}
              </div>

              <div class="mv-hero-subheading-slot">
                {%- if block.settings.subheading != blank -%}
                  <p class="mv-hero-subheading">{{ block.settings.subheading | escape }}</p>
                {%- endif -%}
              </div>

              <div class="mv-hero-btn-slot">
                {%- if block.settings.button_label != blank or block.settings.secondary_button_label != blank -%}
                  <div class="mv-hero-btn-row">
                    {%- if block.settings.button_label != blank -%}
                      <a href="{{ primary_link }}" class="mv-hero-btn-primary">
                        <span class="mv-btn-label">{{ block.settings.button_label | escape }}</span>
                        <span class="mv-btn-arrow-ring">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
                        </span>
                      </a>
                    {%- endif -%}
                    {%- if block.settings.secondary_button_label != blank -%}
                      <a href="{{ secondary_url }}" class="mv-hero-btn-secondary">
                        <span>{{ block.settings.secondary_button_label | escape }}</span>
                        <span class="mv-gold-line"></span>
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="mv-hero-controls">
      <div class="mv-hero-counter">
        <span class="mv-counter-current" id="mv-current-num">01</span>
        <div class="mv-counter-track">
          <div class="mv-counter-fill" id="mv-counter-fill"></div>
        </div>
        <span class="mv-counter-total">0{{ section.blocks.size }}</span>
      </div>

      <div class="mv-hero-arrows">
        <button class="mv-hero-nav-btn mv-nav-prev" aria-label="Previous Slide">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="mv-hero-nav-btn mv-nav-next" aria-label="Next Slide">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
  {%- endif -%}
</div>

<style>
  #mv-slideshow-{{ section.id }} {
    position: relative;
    width: 100%;
    height: var(--hero-desktop-h, calc(100vh - var(--header-group-height, 100px)));
    min-height: 560px;
    overflow: hidden;
    background: #FAF8F5;
  }

  @media (max-width: 749px) {
    #mv-slideshow-{{ section.id }} {
      aspect-ratio: auto;
      height: var(--hero-mobile-h, 78vh);
      min-height: clamp(540px, var(--hero-mobile-h, 78vh), 720px);
      max-height: 750px;
    }
    .mv-hero-bg-img {
      object-position: var(--img-pos-mobile, center center) !important;
    }
  }

  .mv-slideshow-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  .mv-hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none !important;
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.7s;
    z-index: 1;
    display: flex;
    align-items: center;
  }

  .mv-hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto !important;
    z-index: 5;
  }

  .mv-hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .mv-hero-media picture,
  .mv-hero-picture {
    display: block;
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .mv-hero-bg-img,
  .mv-hero-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--img-pos-desktop, center 65%);
    display: block;
  }

  /* White background overlay completely removed so photography is 100% natural & vibrant */
  .mv-hero-overlay {
    display: none !important;
  }

  .mv-hero-media-link {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    display: block;
    cursor: pointer;
    text-decoration: none;
  }

  .mv-hero-container {
    position: relative;
    z-index: 6;
    width: 100%;
    max-width: 1560px;
    margin: 0 auto;
    padding: 0 clamp(20px, 3vw, 44px);
    height: 100%;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .mv-hero-content-wrapper {
    width: 100%;
    display: flex;
    pointer-events: none;
  }

  .mv-pos-left { justify-content: flex-start; text-align: left; }
  .mv-pos-center { justify-content: center; text-align: center; }
  .mv-pos-right { justify-content: flex-end; text-align: right; }

  /* Luxury Transparent Glass Editorial Card - Transparent with subtle blur */
  .mv-hero-editorial-content {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1.5px solid rgba(201, 158, 62, 0.45);
    border-radius: 24px;
    padding: 28px 32px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    pointer-events: auto;
    z-index: 10;
  }

  .mv-hero-title-anchor {
    text-decoration: none;
    color: inherit;
    display: block;
    cursor: pointer;
  }
  .mv-hero-title-anchor:hover .mv-hero-title {
    color: #8C651E;
  }

  .mv-hero-eyebrow-slot {
    display: flex;
    align-items: center;
    margin-bottom: 14px;
  }

  .mv-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.85);
    border: 1.5px solid #C99E3E;
    padding: 6px 18px;
    border-radius: 50px;
    color: #8C651E;
    font-family: var(--mv-font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    box-shadow: 0 4px 15px rgba(201, 165, 69, 0.14);
  }

  .mv-eyebrow-star {
    color: #C99E3E;
    font-size: 0.85rem;
  }

  .mv-hero-title-slot {
    display: block;
    margin-bottom: 14px;
  }

  .mv-hero-title {
    color: #0E281F;
    font-family: 'Marcellus', 'Playfair Display', Georgia, serif;
    font-size: var(--hero-title-desktop, clamp(2.2rem, 3.4vw, 3.1rem));
    line-height: 1.15;
    margin: 0;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.95), 0 2px 14px rgba(255, 255, 255, 0.85);
  }

  .mv-hero-subheading-slot {
    display: block;
    margin-bottom: 24px;
  }

  .mv-hero-subheading {
    color: #1A1613;
    font-family: var(--mv-font-sans);
    font-size: var(--hero-sub-desktop, 0.98rem);
    line-height: 1.62;
    margin: 0;
    font-weight: 500;
    letter-spacing: 0.01em;
    max-width: 440px;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.95), 0 2px 10px rgba(255, 255, 255, 0.85);
  }

  .mv-hero-btn-slot {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 20;
    pointer-events: auto;
  }

  .mv-hero-btn-row {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
    margin: 0;
    position: relative;
    z-index: 20;
    pointer-events: auto;
  }

  /* Primary Button: Royal Emerald with 24K Liquid Gold Metallic Gradient */
  .mv-hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 15px 32px;
    background: #0E281F;
    color: #FFFFFF !important;
    font-family: var(--mv-font-sans);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-radius: 50px;
    text-decoration: none;
    border: 1.5px solid #C99E3E;
    box-shadow: 0 10px 28px rgba(14, 40, 31, 0.28);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    z-index: 25;
    pointer-events: auto !important;
  }

  .mv-hero-btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(201, 165, 69, 0.4), transparent);
    transition: transform 0.6s ease;
    pointer-events: none !important;
  }

  .mv-btn-label,
  .mv-btn-arrow-ring,
  .mv-btn-arrow-ring * {
    pointer-events: none;
  }

  .mv-hero-btn-primary:hover::before {
    transform: translateX(350%);
  }

  .mv-hero-btn-primary:hover {
    background: linear-gradient(135deg, #DFB76C 0%, #C59B45 42%, #9E7429 100%);
    color: #FFFFFF !important;
    border-color: #DFB76C;
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(163, 126, 51, 0.45);
  }

  .mv-btn-arrow-ring {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(201, 165, 69, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #F5E8C7;
    border: 1px solid rgba(201, 165, 69, 0.5);
    transition: all 0.3s ease;
  }

  .mv-hero-btn-primary:hover .mv-btn-arrow-ring {
    transform: translateX(4px);
    background: #FFFFFF;
    color: #0E281F;
    border-color: #FFFFFF;
  }

  /* Secondary Button: Chic Underlined Editorial Link */
  .mv-hero-btn-secondary {
    display: inline-flex;
    flex-direction: column;
    font-family: var(--mv-font-sans);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0E281F !important;
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 4px 0;
  }

  .mv-gold-line {
    width: 100%;
    height: 1.5px;
    background: #C99E3E;
    margin-top: 4px;
    transition: all 0.3s ease;
  }

  .mv-hero-btn-secondary:hover {
    color: #C99E3E !important;
  }

  .mv-hero-btn-secondary:hover .mv-gold-line {
    background: #0E281F;
    transform: scaleX(1.1);
  }

  /* Luxury Watchmaker Bottom Controls */
  .mv-hero-controls {
    position: absolute;
    bottom: 22px;
    right: 48px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 20px;
    background: rgba(250, 248, 245, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(201, 165, 69, 0.45);
    padding: 8px 18px;
    border-radius: 50px;
    box-shadow: 0 12px 36px rgba(14, 40, 31, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .mv-hero-counter {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mv-font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: #0E281F;
  }

  .mv-counter-current {
    font-family: var(--mv-font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: #0E281F;
  }

  .mv-counter-total {
    font-family: var(--mv-font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    color: #8C847A;
  }

  .mv-counter-track {
    width: 48px;
    height: 2.5px;
    background: rgba(201, 165, 69, 0.25);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }

  .mv-counter-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 25%;
    background: linear-gradient(90deg, #DFB76C, #9E7429);
    border-radius: 2px;
    transition: width 0.4s ease;
  }

  .mv-hero-arrows {
    display: flex;
    gap: 6px;
  }

  .mv-hero-nav-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(201, 165, 69, 0.4);
    color: #0E281F;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mv-hero-nav-btn:hover {
    background: linear-gradient(135deg, #0E281F 0%, #163E30 100%);
    color: #DFB76C;
    border-color: #DFB76C;
    transform: scale(1.08);
  }

  @media (max-width: 749px) {
    /* Completely remove white background wash on mobile - 100% vibrant photography */
    .mv-hero-overlay {
      display: none !important;
    }

    .mv-hero-media picture,
    .mv-hero-picture {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      position: absolute !important;
      inset: 0 !important;
    }

    .mv-hero-bg-img,
    .mv-hero-placeholder {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: var(--img-pos-mobile, center center) !important;
      display: block !important;
    }

    .mv-hero-slide {
      align-items: flex-start;
    }

    .mv-hero-container {
      padding: clamp(10px, 2vh, 18px) 14px 0;
      align-items: flex-start;
      justify-content: center;
    }

    .mv-hero-content-wrapper {
      justify-content: center;
      text-align: center;
    }

    /* Luxury Transparent Glass Card on Mobile - Compact & Refined to keep product visible */
    .mv-hero-editorial-content {
      max-width: 380px;
      width: 100%;
      background: rgba(255, 255, 255, 0.22);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1.5px solid rgba(201, 158, 62, 0.45);
      border-radius: 18px;
      padding: 14px 16px 12px;
      box-shadow: 0 8px 26px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.6);
      text-align: center;
      align-items: center;
      height: auto;
      min-height: auto;
    }

    .mv-hero-eyebrow-slot {
      justify-content: center;
      margin-bottom: 4px;
    }

    .mv-hero-eyebrow {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid #C99E3E;
      color: #8C651E;
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      padding: 3px 12px;
      box-shadow: none;
    }

    .mv-hero-title-slot {
      height: auto;
      min-height: auto;
      margin-bottom: 4px;
    }

    .mv-hero-title {
      font-size: var(--hero-title-mobile, clamp(1.4rem, 5vw, 1.7rem));
      line-height: 1.15;
      color: #0E281F;
      font-weight: 500;
      text-shadow: 0 1px 2px rgba(255, 255, 255, 0.95), 0 2px 10px rgba(255, 255, 255, 0.85);
    }

    .mv-hero-subheading-slot {
      height: auto;
      min-height: auto;
      margin-bottom: 10px;
    }

    .mv-hero-subheading {
      font-size: var(--hero-sub-mobile, 0.78rem);
      line-height: 1.35;
      color: #1A1613;
      font-weight: 500;
      text-shadow: 0 1px 2px rgba(255, 255, 255, 0.95), 0 2px 8px rgba(255, 255, 255, 0.85);
      max-width: 320px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .mv-hero-btn-slot {
      justify-content: center;
      width: 100%;
    }

    .mv-hero-btn-row {
      justify-content: center;
      gap: 12px;
    }

    .mv-hero-btn-primary {
      padding: 9px 20px;
      font-size: 0.68rem;
      letter-spacing: 0.14em;
    }

    .mv-hero-btn-secondary {
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      color: #0E281F !important;
      text-shadow: none;
      padding: 2px 0;
    }

    .mv-hero-controls {
      bottom: 12px;
      right: 14px;
      padding: 5px 12px;
      gap: 10px;
      border-radius: 40px;
    }

    .mv-counter-track {
      width: 32px;
    }

    .mv-hero-nav-btn {
      width: 28px;
      height: 28px;
    }
  }
</style>

<script>
  (function() {
    function initSlideshow() {
      const wrap = document.getElementById('mv-slideshow-{{ section.id }}');
      if (!wrap) return;

      const slides = wrap.querySelectorAll('.mv-hero-slide');
      const prevBtn = wrap.querySelector('.mv-nav-prev');
      const nextBtn = wrap.querySelector('.mv-nav-next');
      const curNum = wrap.querySelector('#mv-current-num');
      const barFill = wrap.querySelector('#mv-counter-fill');
      let currentIndex = 0;
      let timer = null;
      const isAutoplay = wrap.dataset.autoplay === 'true';
      const speed = parseInt(wrap.dataset.speed, 10) * 1000 || 6000;
      const total = slides.length;

      function goToSlide(index) {
        if (index < 0) index = total - 1;
        if (index >= total) index = 0;
        currentIndex = index;

        slides.forEach((s, i) => {
          s.classList.toggle('is-active', i === currentIndex);
        });

        if (curNum) {
          curNum.textContent = '0' + (currentIndex + 1);
        }
        if (barFill && total > 0) {
          barFill.style.width = (((currentIndex + 1) / total) * 100) + '%';
        }
      }

      function startAutoplay() {
        if (!isAutoplay || total <= 1) return;
        stopAutoplay();
        timer = setInterval(() => {
          goToSlide(currentIndex + 1);
        }, speed);
      }

      function stopAutoplay() {
        if (timer) clearInterval(timer);
      }

      if (prevBtn) {
        prevBtn.onclick = function(e) {
          e.preventDefault();
          goToSlide(currentIndex - 1);
          startAutoplay();
        };
      }

      if (nextBtn) {
        nextBtn.onclick = function(e) {
          e.preventDefault();
          goToSlide(currentIndex + 1);
          startAutoplay();
        };
      }

      wrap.onmouseenter = stopAutoplay;
      wrap.onmouseleave = startAutoplay;

      // Touch swipe
      let startX = 0;
      let startY = 0;
      wrap.addEventListener('touchstart', (e) => {
        if (e.target.closest('a, button, .mv-hero-controls, .mv-hero-btn-primary, .mv-hero-btn-secondary')) return;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        stopAutoplay();
      }, { passive: true });

      wrap.addEventListener('touchend', (e) => {
        if (e.target.closest('a, button, .mv-hero-controls, .mv-hero-btn-primary, .mv-hero-btn-secondary')) return;
        const diffX = e.changedTouches[0].clientX - startX;
        const diffY = e.changedTouches[0].clientY - startY;
        if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 45) {
          if (diffX > 45) {
            goToSlide(currentIndex - 1);
          } else if (diffX < -45) {
            goToSlide(currentIndex + 1);
          }
        }
        startAutoplay();
      }, { passive: true });

      startAutoplay();

      // Shopify Theme Editor Block Selection Support
      document.addEventListener('shopify:block:select', function(e) {
        if (!wrap) return;
        const targetSlide = wrap.querySelector('#mv-slide-' + e.detail.blockId);
        if (targetSlide) {
          const targetIndex = parseInt(targetSlide.dataset.index, 10);
          if (!isNaN(targetIndex)) {
            stopAutoplay();
            goToSlide(targetIndex);
          }
        }
      });

      document.addEventListener('shopify:block:deselect', function() {
        startAutoplay();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSlideshow);
    } else {
      initSlideshow();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (!e.target || e.target.contains(document.getElementById('mv-slideshow-{{ section.id }}')) || e.target.id === 'shopify-section-{{ section.id }}') {
        initSlideshow();
      }
    });

    document.addEventListener('shopify:section:select', function(e) {
      if (!e.target || e.target.contains(document.getElementById('mv-slideshow-{{ section.id }}'))) {
        initSlideshow();
      }
    });
  })();
</script>

