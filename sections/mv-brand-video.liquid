<script>
  (function() {
    function initVideoSection() {
      const poster = document.getElementById('mv-poster-{{ section.id }}');
      const embedWrap = document.getElementById('mv-embed-{{ section.id }}');
      const iframe = document.getElementById('mv-iframe-{{ section.id }}');
      const closeBtn = document.getElementById('mv-close-{{ section.id }}');

      if (!poster || !embedWrap || !iframe) return;

      function playVideo() {
        poster.style.display = 'none';
        embedWrap.style.display = 'block';
        if (!iframe.src || iframe.src === 'about:blank' || iframe.src.indexOf('youtube') === -1) {
          iframe.src = iframe.getAttribute('data-src');
        }
      }

      function stopVideo() {
        embedWrap.style.display = 'none';
        poster.style.display = 'block';
        iframe.src = '';
      }

      poster.addEventListener('click', playVideo);
      poster.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          playVideo();
        }
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          stopVideo();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoSection);
    } else {
      initVideoSection();
    }
  })();
</script>

