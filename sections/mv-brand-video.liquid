<div class="mv-video-section" id="mv-video-{{ section.id }}">
  <div class="mv-container">
    <div class="mv-video-header mv-section-header">
      {%- if section.settings.badge != blank -%}
        <span class="mv-section-badge" style="background: rgba(232, 211, 162, 0.15); color: #E8D3A2; border-color: rgba(232, 211, 162, 0.35);">{{ section.settings.badge | escape }}</span>
      {%- endif -%}
      <h2 class="mv-section-title" style="color: #FFFFFF;">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="mv-section-subtitle" style="color: rgba(250, 248, 245, 0.82);">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      <div class="mv-divider-accent"></div>
    </div>

    <div class="mv-video-box">
      <div class="mv-video-poster" id="mv-poster-{{ section.id }}">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1800 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w"
            sizes="(max-width: 990px) 100vw, 1200px"
            alt="{{ section.settings.video_title | default: 'Myra Veda Brand Story' | escape }}"
            loading="lazy"
            class="mv-video-cover-img"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'mv-video-placeholder' }}
        {%- endif -%}
        <div class="mv-video-scrim"></div>

        <div class="mv-video-trigger-content">
          <button class="mv-play-btn" id="mv-play-btn-{{ section.id }}" aria-label="Play Video">
            <span class="mv-play-ripple"></span>
            <span class="mv-play-ripple delayed"></span>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          </button>
          {%- if section.settings.video_title != blank -%}
            <span class="mv-video-label">{{ section.settings.video_title | escape }}</span>
          {%- endif -%}
        </div>
      </div>

      <div class="mv-video-frame-wrap" id="mv-frame-wrap-{{ section.id }}" style="display: none;">
        {%- assign video_url = section.settings.video_url -%}
        {%- if video_url contains 'youtu.be' -%}
          {%- assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
        {%- elsif video_url contains 'watch?v=' -%}
          {%- assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first -%}
        {%- else -%}
          {%- assign video_id = 'OqAXQOmucX4' -%}
        {%- endif -%}
        <iframe
          id="mv-iframe-{{ section.id }}"
          data-src="https://www.youtube-nocookie.com/embed/{{ video_id }}?autoplay=1&rel=0&modestbranding=1"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="mv-video-iframe"
          title="{{ section.settings.video_title | escape }}"
        ></iframe>
      </div>
    </div>
  </div>
</div>

<style>
  #mv-video-{{ section.id }} {
    padding: clamp(44px, 5.5vw, 66px) 24px;
    background: radial-gradient(ellipse at 50% 30%, #0E281F 0%, #071913 100%);
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(201, 158, 62, 0.3);
    border-bottom: 1px solid rgba(201, 158, 62, 0.3);
  }

  .mv-video-box {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1.5px solid rgba(201, 158, 62, 0.55);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(201, 158, 62, 0.2);
    background: #071913;
  }

  .mv-video-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .mv-video-cover-img,
  .mv-video-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  .mv-video-box:hover .mv-video-cover-img {
    transform: scale(1.05);
  }

  .mv-video-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 25, 19, 0.25) 0%, rgba(7, 25, 19, 0.78) 100%);
    pointer-events: none;
  }

  .mv-video-trigger-content {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .mv-play-btn {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: var(--mv-gold-gradient);
    border: none;
    color: #0E281F;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    box-shadow: 0 10px 36px rgba(201, 158, 62, 0.6);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .mv-play-btn svg {
    margin-left: 5px;
  }

  .mv-play-btn:hover {
    transform: scale(1.12);
    box-shadow: 0 14px 44px rgba(201, 158, 62, 0.8);
  }

  .mv-play-ripple {
    position: absolute;
    inset: -14px;
    border: 2px solid rgba(201, 158, 62, 0.65);
    border-radius: 50%;
    animation: mvRipple 2.2s infinite ease-out;
  }

  .mv-play-ripple.delayed {
    animation-delay: 1.1s;
  }

  @keyframes mvRipple {
    0% { transform: scale(0.85); opacity: 1; }
    100% { transform: scale(1.45); opacity: 0; }
  }

  .mv-video-label {
    color: #FFFFFF;
    font-family: var(--mv-font-serif);
    font-size: 1.45rem;
    letter-spacing: 0.05em;
    font-weight: 500;
    text-shadow: 0 2px 12px rgba(0,0,0,0.6);
  }

  .mv-video-frame-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mv-video-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (max-width: 640px) {
    #mv-video-{{ section.id }} {
      padding: 36px 18px;
    }
    .mv-play-btn {
      width: 68px;
      height: 68px;
    }
    .mv-play-btn svg {
      width: 22px;
      height: 22px;
    }
    .mv-video-label {
      font-size: 1.15rem;
    }
    .mv-video-box {
      border-radius: 18px;
    }
  }
</style>

<script>
  (function() {
    const poster = document.getElementById('mv-poster-{{ section.id }}');
    const frameWrap = document.getElementById('mv-frame-wrap-{{ section.id }}');
    const iframe = document.getElementById('mv-iframe-{{ section.id }}');

    if (poster && frameWrap && iframe) {
      poster.addEventListener('click', function() {
        poster.style.display = 'none';
        frameWrap.style.display = 'block';
        iframe.src = iframe.getAttribute('data-src');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "MV Brand Video",
  "tag": "section",
  "class": "mv-video-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Behind The Formulations"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Brand Stands For"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Watch how our passion for clean beauty and ancient botanical heritage unfolds"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster Image"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video Label",
      "default": "Watch Our Story"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "YouTube Video URL",
      "default": "https://youtu.be/OqAXQOmucX4"
    }
  ],
  "presets": [
    {
      "name": "MV Brand Video"
    }
  ]
}
{% endschema %}
