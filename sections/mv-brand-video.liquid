<div class="mv-brand-video-section" id="mv-video-{{ section.id }}" style="--vid-heading-desktop: {{ section.settings.heading_size_desktop | default: 34 }}px; --vid-heading-mobile: {{ section.settings.heading_size_mobile | default: 24 }}px; --vid-label-desktop: {{ section.settings.video_label_size_desktop | default: 20 }}px; --vid-label-mobile: {{ section.settings.video_label_size_mobile | default: 15 }}px; --vid-pt: {{ section.settings.padding_top | default: 45 }}px; --vid-pb: {{ section.settings.padding_bottom | default: 45 }}px; --vid-ratio: {{ section.settings.aspect_ratio | default: '16 / 9' }};">
  
  <!-- Subtle ambient luxury lighting effects -->
  <div class="mv-video-glow mv-glow-top" aria-hidden="true"></div>
  <div class="mv-video-glow mv-glow-center" aria-hidden="true"></div>

  <div class="mv-container">
    <!-- Header Architecture - Screen-Proportional -->
    <div class="mv-video-header">
      {%- if section.settings.badge != blank -%}
        <div class="mv-video-badge-pill">
          <span class="mv-badge-star">✦</span>
          <span class="mv-badge-label">{{ section.settings.badge | escape }}</span>
          <span class="mv-badge-star">✦</span>
        </div>
      {%- endif -%}

      <h2 class="mv-video-title">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.subheading != blank -%}
        <p class="mv-video-subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <div class="mv-video-divider" aria-hidden="true">
        <span class="mv-divider-line"></span>
        <span class="mv-divider-gem">✦</span>
        <span class="mv-divider-line"></span>
      </div>
    </div>

    <!-- Screen-Fitted Cinematic Video Showcase Box -->
    <div class="mv-video-showcase">
      <div class="mv-showcase-glow" aria-hidden="true"></div>

      <div class="mv-video-frame" id="mv-frame-{{ section.id }}">
        
        <!-- Architectural 24K Gold Corner Brackets -->
        <span class="mv-frame-corner mv-corner-tl" aria-hidden="true"></span>
        <span class="mv-frame-corner mv-corner-tr" aria-hidden="true"></span>
        <span class="mv-frame-corner mv-corner-bl" aria-hidden="true"></span>
        <span class="mv-frame-corner mv-corner-br" aria-hidden="true"></span>

        <!-- Floating Cinema Status Tag -->
        <div class="mv-frame-film-tag" aria-hidden="true">
          <span class="mv-film-rec-dot"></span>
          <span class="mv-film-tag-label">MYRA VEDA CINEMA</span>
        </div>

        <!-- Poster & Centerpiece Play Action Layer -->
        <div class="mv-video-poster" id="mv-poster-{{ section.id }}" role="button" tabindex="0" aria-label="Play {{ section.settings.video_title | default: 'Brand Story Film' | escape }}">
          {%- if section.settings.image != blank -%}
            <picture class="mv-poster-picture">
              {%- if section.settings.mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
              {%- endif -%}
              <img
                src="{{ section.settings.image | image_url: width: 1600 }}"
                srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1000 }} 1000w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
                sizes="(max-width: 749px) 100vw, 860px"
                alt="{{ section.settings.heading | default: 'Myra Veda Clean Luxury' | escape }}"
                loading="lazy"
                class="mv-poster-img"
              >
            </picture>
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'mv-poster-img mv-poster-placeholder' }}
          {%- endif -%}

          <!-- Cinematic Scrim Gradient (Warm Golden Vignette) -->
          <div class="mv-poster-scrim" aria-hidden="true"></div>

          <!-- Centered Glowing Play Centerpiece -->
          <div class="mv-poster-content" aria-hidden="true">
            <div class="mv-play-btn-box">
              <button class="mv-play-btn" type="button" aria-label="Play film">
                <span class="mv-play-ripple ring-1"></span>
                <span class="mv-play-ripple ring-2"></span>
                <span class="mv-play-btn-circle">
                  <svg class="mv-play-svg" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="6 4 20 12 6 20 6 4"></polygon>
                  </svg>
                </span>
              </button>
            </div>

            {%- if section.settings.video_title != blank -%}
              <div class="mv-video-pill">
                <span class="mv-pill-play-icon">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                </span>
                <span class="mv-pill-text">{{ section.settings.video_title | escape }}</span>
                <span class="mv-pill-sep">◆</span>
                <span class="mv-pill-tag">2 MIN FILM</span>
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- YouTube Video Embed Player Container -->
        <div class="mv-video-embed" id="mv-embed-{{ section.id }}" style="display: none;">
          {%- assign video_url = section.settings.video_url -%}
          {%- if video_url contains 'youtu.be' -%}
            {%- assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
          {%- elsif video_url contains 'watch?v=' -%}
            {%- assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first -%}
          {%- else -%}
            {%- assign video_id = 'OqAXQOmucX4' -%}
          {%- endif -%}
          
          <button class="mv-video-close-btn" id="mv-close-{{ section.id }}" type="button" aria-label="Close video player">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <iframe
            id="mv-iframe-{{ section.id }}"
            data-src="https://www.youtube-nocookie.com/embed/{{ video_id }}?autoplay=1&rel=0&modestbranding=1&enablejsapi=1"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="mv-video-iframe"
            title="{{ section.settings.video_title | default: 'Brand Video' | escape }}"
          ></iframe>
        </div>

      </div>
    </div>

    <!-- Luxury Formulation Seals (Clean Beauty Standards) -->
    {%- if section.settings.show_pillars == true and section.blocks.size > 0 -%}
      <div class="mv-formulation-pillars">
        <div class="mv-pillars-grid">
          {%- for block in section.blocks -%}
            <div class="mv-pillar-item" {{ block.shopify_attributes }}>
              <div class="mv-pillar-icon-wrap">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  {%- when 'heart' -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                  {%- when 'certificate' -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                  {%- else -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
                {%- endcase -%}
              </div>
              <div class="mv-pillar-info">
                <h4 class="mv-pillar-name">{{ block.settings.title | escape }}</h4>
                {%- if block.settings.description != blank -%}
                  <p class="mv-pillar-sub">{{ block.settings.description | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

<style>
  /* ==========================================================================
     HAUTE LUXE GRAND BRAND VIDEO SHOWCASE - CINEMATIC SCALE
     ========================================================================== */
  #mv-video-{{ section.id }} {
    position: relative;
    padding-top: var(--vid-pt, 48px);
    padding-bottom: var(--vid-pb, 48px);
    padding-left: 20px;
    padding-right: 20px;
    background: radial-gradient(ellipse 90% 60% at 50% 15%, #103628 0%, #081F17 50%, #030D0A 100%);
    border-top: 1px solid rgba(212, 175, 55, 0.32);
    border-bottom: 1px solid rgba(212, 175, 55, 0.32);
    overflow: hidden;
    scroll-margin-top: calc(var(--header-height, 90px) + 24px);
  }

  #mv-video-{{ section.id }} .mv-container {
    max-width: 1140px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  /* Multi-Layered Ambient Light Auras */
  #mv-video-{{ section.id }} .mv-video-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }
  #mv-video-{{ section.id }} .mv-glow-top {
    width: 500px;
    height: 300px;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(212, 175, 55, 0.22) 0%, transparent 70%);
  }
  #mv-video-{{ section.id }} .mv-glow-center {
    width: 700px;
    height: 450px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse, rgba(16, 54, 40, 0.42) 0%, transparent 70%);
  }

  /* Header Typography Architecture */
  #mv-video-{{ section.id }} .mv-video-header {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 28px;
    position: relative;
    z-index: 3;
  }

  #mv-video-{{ section.id }} .mv-video-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 16px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.16) 0%, rgba(212, 175, 55, 0.05) 100%);
    border: 1px solid rgba(212, 175, 55, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    margin-bottom: 10px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }

  #mv-video-{{ section.id }} .mv-badge-star {
    color: #E2BA55;
    font-size: 10px;
    line-height: 1;
  }

  #mv-video-{{ section.id }} .mv-badge-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #F9E7B9;
    line-height: 1;
  }

  /* FORCED BRIGHT WHITE TITLE */
  #mv-video-{{ section.id }} .mv-video-title {
    font-family: 'Marcellus', 'Playfair Display', Georgia, serif !important;
    font-size: var(--vid-heading-desktop, clamp(1.85rem, 2.8vw, 2.4rem)) !important;
    font-weight: 500 !important;
    color: #FFFFFF !important;
    line-height: 1.2 !important;
    letter-spacing: 0.025em !important;
    margin: 0 0 10px !important;
    text-shadow: 0 3px 20px rgba(0, 0, 0, 0.85), 0 0 35px rgba(212, 175, 55, 0.22) !important;
  }

  #mv-video-{{ section.id }} .mv-video-subtitle {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    font-weight: 400;
    color: #E2D9C8;
    line-height: 1.5;
    letter-spacing: 0.01em;
    margin: 0 auto;
    max-width: 660px;
  }

  /* Symmetrical Royal Golden Divider */
  #mv-video-{{ section.id }} .mv-video-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: 14px auto 0;
    max-width: 170px;
  }

  #mv-video-{{ section.id }} .mv-divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.7), transparent);
  }

  #mv-video-{{ section.id }} .mv-divider-gem {
    color: #E2BA55;
    font-size: 11px;
    text-shadow: 0 0 8px rgba(212, 175, 55, 0.8);
  }

  /* Grand Cinematic Showcase Player - WIDE & PROMINENT */
  #mv-video-{{ section.id }} .mv-video-showcase {
    max-width: min(1080px, 94vw);
    width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 3;
  }

  /* Radiant Golden Glow Behind Frame */
  #mv-video-{{ section.id }} .mv-showcase-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    height: 80%;
    background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.22) 0%, rgba(16, 54, 40, 0.35) 50%, transparent 75%);
    filter: blur(55px);
    pointer-events: none;
    z-index: 1;
  }

  /* High-End Video Frame Box */
  #mv-video-{{ section.id }} .mv-video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--vid-ratio, 16 / 9);
    border-radius: 24px;
    overflow: hidden;
    background: #030D0A;
    border: 1.5px solid rgba(212, 175, 55, 0.58);
    box-shadow: 0 24px 75px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.1), 0 0 45px rgba(212, 175, 55, 0.18);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
    z-index: 2;
  }

  #mv-video-{{ section.id }} .mv-video-frame:hover {
    border-color: rgba(212, 175, 55, 0.88);
    box-shadow: 0 28px 85px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(212, 175, 55, 0.45), 0 0 60px rgba(212, 175, 55, 0.28);
  }

  /* Architectural 24K Gold Corner Brackets */
  #mv-video-{{ section.id }} .mv-frame-corner {
    position: absolute;
    width: 20px;
    height: 20px;
    pointer-events: none;
    z-index: 6;
  }
  #mv-video-{{ section.id }} .mv-corner-tl {
    top: 16px; left: 16px;
    border-top: 2px solid rgba(226, 186, 85, 0.88);
    border-left: 2px solid rgba(226, 186, 85, 0.88);
    border-top-left-radius: 5px;
  }
  #mv-video-{{ section.id }} .mv-corner-tr {
    top: 16px; right: 16px;
    border-top: 2px solid rgba(226, 186, 85, 0.88);
    border-right: 2px solid rgba(226, 186, 85, 0.88);
    border-top-right-radius: 5px;
  }
  #mv-video-{{ section.id }} .mv-corner-bl {
    bottom: 16px; left: 16px;
    border-bottom: 2px solid rgba(226, 186, 85, 0.88);
    border-left: 2px solid rgba(226, 186, 85, 0.88);
    border-bottom-left-radius: 5px;
  }
  #mv-video-{{ section.id }} .mv-corner-br {
    bottom: 16px; right: 16px;
    border-bottom: 2px solid rgba(226, 186, 85, 0.88);
    border-right: 2px solid rgba(226, 186, 85, 0.88);
    border-bottom-right-radius: 5px;
  }

  /* Floating Cinema Status Tag */
  #mv-video-{{ section.id }} .mv-frame-film-tag {
    position: absolute;
    top: 18px;
    left: 22px;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(3, 13, 10, 0.75);
    border: 1px solid rgba(212, 175, 55, 0.42);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 5px 14px;
    border-radius: 999px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  #mv-video-{{ section.id }} .mv-film-rec-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E2BA55;
    box-shadow: 0 0 8px #E2BA55;
    animation: mvRecPulse 2s infinite ease-in-out;
  }
  @keyframes mvRecPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  #mv-video-{{ section.id }} .mv-film-tag-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #F9E7B9;
    text-transform: uppercase;
  }

  /* Full-Bleed Video Poster Layer */
  #mv-video-{{ section.id }} .mv-video-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    overflow: hidden;
  }

  #mv-video-{{ section.id }} .mv-poster-picture,
  #mv-video-{{ section.id }} .mv-poster-img,
  #mv-video-{{ section.id }} .mv-poster-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    filter: saturate(1.12) contrast(1.04);
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #mv-video-{{ section.id }} .mv-video-frame:hover .mv-poster-img {
    transform: scale(1.04);
  }

  /* Cinematic Scrim Gradient */
  #mv-video-{{ section.id }} .mv-poster-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(3, 13, 10, 0.1) 0%, rgba(3, 13, 10, 0.32) 50%, rgba(3, 13, 10, 0.82) 100%),
                linear-gradient(180deg, rgba(3, 13, 10, 0.2) 0%, transparent 40%, rgba(3, 13, 10, 0.68) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* Centered Play Trigger */
  #mv-video-{{ section.id }} .mv-poster-content {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    pointer-events: none;
  }

  /* 24K Glowing Liquid Gold Play Button */
  #mv-video-{{ section.id }} .mv-play-btn-box {
    position: relative;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
  }

  #mv-video-{{ section.id }} .mv-play-btn {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    outline: none;
  }

  #mv-video-{{ section.id }} .mv-play-btn-circle {
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: linear-gradient(135deg, #FFF8E1 0%, #E2BA55 45%, #9E7416 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.65), 0 0 35px rgba(212, 175, 55, 0.75);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
    z-index: 3;
  }

  #mv-video-{{ section.id }} .mv-play-svg {
    width: 22px;
    height: 22px;
    color: #061811;
    margin-left: 3px;
    transition: transform 0.3s ease;
  }

  #mv-video-{{ section.id }} .mv-video-frame:hover .mv-play-btn-circle {
    transform: scale(1.12);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.75), 0 0 50px rgba(212, 175, 55, 0.95);
  }

  /* Multi-Ring Pulse Waves */
  #mv-video-{{ section.id }} .mv-play-ripple {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1.5px solid rgba(226, 186, 85, 0.7);
    animation: mvWaveRipple 2.4s infinite cubic-bezier(0.2, 0, 0, 1);
    pointer-events: none;
    z-index: 1;
  }
  #mv-video-{{ section.id }} .mv-play-ripple.ring-2 { animation-delay: 1.2s; }

  @keyframes mvWaveRipple {
    0% { transform: scale(0.85); opacity: 1; }
    100% { transform: scale(1.7); opacity: 0; }
  }

  /* Luxury Caption Pill Below Play Button */
  #mv-video-{{ section.id }} .mv-video-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 22px;
    border-radius: 999px;
    background: rgba(3, 13, 10, 0.82);
    border: 1px solid rgba(212, 175, 55, 0.52);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    pointer-events: auto;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  #mv-video-{{ section.id }} .mv-video-frame:hover .mv-video-pill {
    transform: translateY(-2px);
    border-color: rgba(212, 175, 55, 0.88);
  }

  #mv-video-{{ section.id }} .mv-pill-play-icon {
    color: #E2BA55;
    display: flex;
    align-items: center;
  }

  #mv-video-{{ section.id }} .mv-pill-text {
    font-family: 'Marcellus', 'Playfair Display', Georgia, serif;
    font-size: var(--vid-label-desktop, 1.05rem);
    font-weight: 500;
    color: #FFFFFF;
    letter-spacing: 0.04em;
  }

  #mv-video-{{ section.id }} .mv-pill-sep {
    font-size: 7px;
    color: #E2BA55;
    opacity: 0.8;
  }

  #mv-video-{{ section.id }} .mv-pill-tag {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #F9E7B9;
  }

  /* Embedded Player & Close Button */
  #mv-video-{{ section.id }} .mv-video-embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    background: #000;
  }

  #mv-video-{{ section.id }} .mv-video-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  #mv-video-{{ section.id }} .mv-video-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 20;
    width: 38px;
    height: 38px;
