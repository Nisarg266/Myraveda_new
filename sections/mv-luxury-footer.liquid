    width: 32px;
    height: 32px;
    stroke-width: 2.2px;
    display: block;
    transition: transform 0.35s ease;
  }

  .mv-trust-item:hover .mv-trust-icon-ring {
    background: linear-gradient(135deg, #DFB76C 0%, #C59B45 50%, #9E7429 100%);
