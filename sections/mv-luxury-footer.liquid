  /* 1. TRUST STRIP (COMPACT RHYTHM) */
  .mv-footer-trust-strip {
    border-bottom: 1px solid var(--mv-f-strip-border);
    background: var(--mv-f-strip-bg);
    padding: 15px 0;
  }

  .mv-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(14px, 2vw, 24px);
    align-items: center;
  }

  .mv-trust-item {
    display: flex;
    align-items: center;
    gap: 16px;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mv-trust-item:hover {
    transform: translateY(-2px);
  }

  .mv-trust-icon-ring {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(201, 158, 62, 0.16) 0%, #FFFFFF 100%);
    border: 1.5px solid var(--mv-f-gold-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--mv-f-gold-dark);
    transition: all 0.4s ease;
    box-shadow: 0 3px 12px rgba(14, 40, 31, 0.06);
  }

