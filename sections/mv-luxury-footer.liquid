{% comment %}
  =============================================================================
  MYRA VEDA LUXURY ESSENTIALS - HAUTE LUXE LIGHT WHITE FOOTER
  Balanced Luxury Geometry:
    - Tight, compact vertical padding (eliminates bottom empty space)
    - Full-width balanced 4-column alignment (eliminates right empty space)
    - Integrated inline newsletter pill (compact height, high-fashion aesthetic)
    - Pristine Pure White & Royal 24K Gold Canvas
    - 100% Mobile Optimized Architecture
  =============================================================================
{% endcomment %}

{%- liquid
  assign brand_logo = section.settings.brand_image | default: settings.logo
  assign mobile_brand_logo = section.settings.mobile_brand_image | default: settings.logo
  assign brand_tagline = section.settings.brand_tagline
  assign brand_align = section.settings.brand_alignment | default: 'center'
  assign contact_title = section.settings.contact_title | default: 'CONTACT US'
  assign contact_phone = section.settings.contact_phone | default: '+91-9137254894'
  assign contact_email = section.settings.contact_email | default: 'connect@myravedaluxury.com'
  assign contact_hours = section.settings.contact_hours | default: 'Mon – Sat: 10:00 AM – 7:00 PM IST'
  
  assign social_fb = section.settings.social_facebook | default: 'https://www.facebook.com/myraveda?mibextid=LQQJ4d'
  assign social_ig = section.settings.social_instagram | default: 'https://instagram.com/myraveda?igshid=OGQ5ZDc2ODk2ZA=='
  assign social_tw = section.settings.social_twitter | default: 'https://twitter.com/myravedaluxury?s=11&t=_1FLY9NLg9lMj-gnf1OCnw'
  assign social_yt = section.settings.social_youtube | default: 'https://youtube.com/@myravedaluxuryessentials9186'
  
  assign menu_title = section.settings.menu_title | default: 'QUICK LINKS'
  assign footer_menu_obj = section.settings.menu
  assign menu_links = footer_menu_obj.links
  if menu_links == blank or menu_links.size == 0
    assign menu_links = linklists[footer_menu_obj].links
  endif
  if menu_links == blank or menu_links.size == 0
    assign menu_links = linklists['quick-link'].links
  endif
  if menu_links == blank or menu_links.size == 0
    assign menu_links = linklists['footer'].links
  endif

  assign menu_2_title = section.settings.menu_2_title | default: 'CUSTOMER CARE'
  assign footer_menu_2_obj = section.settings.menu_2
  assign menu_2_links = footer_menu_2_obj.links
  if menu_2_links == blank or menu_2_links.size == 0
    assign menu_2_links = linklists[footer_menu_2_obj].links
  endif
  
  assign newsletter_title = section.settings.newsletter_title | default: 'INSIDER INFORMATION'
  assign newsletter_subtext = section.settings.newsletter_subtext | default: 'Subscribe to receive invitations to private botanical harvests, VIP ritual previews, and 15% off your first order.'
  
  assign scheme = section.settings.color_scheme | default: 'pure_white_gold'
-%}

<div class="mv-footer-wrapper mv-scheme--{{ scheme }}" id="mv-luxury-footer" style="
  {%- if section.settings.custom_bg != blank and section.settings.color_scheme == 'custom' -%}
    --mv-f-bg: {{ section.settings.custom_bg }};
  {%- endif -%}
  {%- if section.settings.custom_heading_color != blank and section.settings.color_scheme == 'custom' -%}
    --mv-f-text-primary: {{ section.settings.custom_heading_color }};
  {%- endif -%}
  {%- if section.settings.custom_text_color != blank and section.settings.color_scheme == 'custom' -%}
    --mv-f-text-secondary: {{ section.settings.custom_text_color }};
  {%- endif -%}
  {%- if section.settings.custom_accent_gold != blank and section.settings.color_scheme == 'custom' -%}
    --mv-f-gold-primary: {{ section.settings.custom_accent_gold }};
  {%- endif -%}
  {%- if section.settings.bottom_bar_bg != blank and section.settings.color_scheme == 'custom' -%}
    --mv-f-bottom-bg: {{ section.settings.bottom_bar_bg }};
  {%- endif -%}
  --mv-footer-pt: {{ section.settings.padding_top_desktop | default: 40 }}px;
  --mv-footer-pb: {{ section.settings.padding_bottom_desktop | default: 28 }}px;
  --mv-footer-pt-mobile: {{ section.settings.padding_top_mobile | default: 28 }}px;
  --mv-footer-pb-mobile: {{ section.settings.padding_bottom_mobile | default: 20 }}px;
  --mv-f-heading-desktop: {{ section.settings.heading_size_desktop | default: 16 }}px;
  --mv-f-heading-mobile: {{ section.settings.heading_size_mobile | default: 15 }}px;
  --mv-f-link-desktop: {{ section.settings.link_size_desktop | default: 14 }}px;
  --mv-f-link-mobile: {{ section.settings.link_size_mobile | default: 13 }}px;
  --mv-f-body-desktop: {{ section.settings.body_size_desktop | default: 14 }}px;
  --mv-f-body-mobile: {{ section.settings.body_size_mobile | default: 13 }}px;
">
  
  {%- if section.settings.show_trust_strip -%}
    <!-- 1. PRE-FOOTER LUXURY TRUST PILLARS (COMPACT LUXE) -->
    <div class="mv-footer-trust-strip">
      <div class="mv-footer-container">
        <div class="mv-trust-grid">
          
          <div class="mv-trust-item">
            <div class="mv-trust-icon-ring">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div class="mv-trust-content">
              <span class="mv-trust-title">100% Sustainable</span>
              <span class="mv-trust-desc">Clean-Beauty Certified</span>
            </div>
          </div>

          <div class="mv-trust-item">
            <div class="mv-trust-icon-ring">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              </svg>
            </div>
            <div class="mv-trust-content">
              <span class="mv-trust-title">Pure Botanicals</span>
              <span class="mv-trust-desc">Wild-Harvested Herbs</span>
            </div>
          </div>

          <div class="mv-trust-item">
            <div class="mv-trust-icon-ring">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="m4.93 4.93 4.24 4.24"/>
                <path d="m14.83 9.17 4.24-4.24"/>
                <path d="m14.83 14.83 4.24 4.24"/>
                <path d="m9.17 14.83-4.24 4.24"/>
                <circle cx="12" cy="12" r="4"/>
              </svg>
            </div>
            <div class="mv-trust-content">
              <span class="mv-trust-title">Cruelty-Free</span>
              <span class="mv-trust-desc">PETA Approved & Ethical</span>
            </div>
          </div>

          <div class="mv-trust-item">
            <div class="mv-trust-icon-ring">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"/>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
            </div>
            <div class="mv-trust-content">
              <span class="mv-trust-title">Global Express</span>
              <span class="mv-trust-desc">Insured Worldwide Delivery</span>
            </div>
          </div>

        </div>
      </div>
    </div>
  {%- endif -%}

  <footer class="mv-footer-main">
    <div class="mv-footer-container">
      {%- if section.blocks.size > 0 -%}
        <div class="mv-footer-grid mv-footer-grid--blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'brand' -%}
                <div class="mv-footer-col mv-footer-col--brand" {{ block.shopify_attributes }}>
                  <div class="mv-footer-brand-stage mv-brand-align--{{ block.settings.brand_alignment | default: 'center' }}">
                    {%- assign b_logo = block.settings.brand_image | default: brand_logo -%}
                    {%- assign b_mob_logo = block.settings.mobile_brand_image | default: mobile_brand_logo -%}
                    {%- if b_logo != blank -%}
                      <a href="{{ routes.root_url }}" class="mv-footer-logo-link" aria-label="{{ shop.name }}">
                        <picture>
                          {%- if b_mob_logo != blank -%}
                            <source media="(max-width: 767px)" srcset="{{ b_mob_logo | image_url: width: 400 }}">
                          {%- endif -%}
                          <img 
                            src="{{ b_logo | image_url: width: 600 }}"
                            alt="{{ shop.name }}"
                            class="mv-footer-logo-img"
                            width="{{ block.settings.logo_width | default: section.settings.logo_width | default: 220 }}"
                            height="auto"
                            loading="lazy"
                          >
                        </picture>
                      </a>
                    {%- else -%}
                      <a href="{{ routes.root_url }}" class="mv-footer-logo-fallback" aria-label="{{ shop.name }}">
                        <span class="mv-logo-emblem">✦</span>
                        <span class="mv-logo-text">MYRA VEDA</span>
                        <span class="mv-logo-subtext">LUXURY ESSENTIALS</span>
                      </a>
                    {%- endif -%}

                    <div class="mv-gold-divider-subtle"></div>

                    <p class="mv-footer-tagline">
                      {%- if block.settings.brand_tagline != blank -%}
                        {{ block.settings.brand_tagline }}
                      {%- else -%}
                        {{ brand_tagline }}
                      {%- endif -%}
                    </p>

                    {%- if block.settings.show_creds != false -%}
                      <div class="mv-footer-creds">
                        <span class="mv-cred-pill">✦ PETA Cruelty-Free</span>
                        <span class="mv-cred-pill">✦ 100% Vegetarian</span>
                        <span class="mv-cred-pill">✦ Sustainable Glass</span>
                      </div>
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'contact' -%}
                <div class="mv-footer-col mv-footer-col--contact" {{ block.shopify_attributes }}>
                  <h3 class="mv-footer-heading">
                    <span class="mv-heading-star">✦</span>
                    {{ block.settings.title | default: contact_title }}
                  </h3>
                  
                  <div class="mv-contact-items">
                    {%- assign b_phone = block.settings.phone | default: contact_phone -%}
                    {%- if b_phone != blank -%}
                      <a href="tel:{{ b_phone | replace: ' ', '' | replace: '-', '' }}" class="mv-contact-card" title="Call Concierge">
                        <div class="mv-contact-icon">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <div class="mv-contact-details">
                          <span class="mv-contact-label">Customer Care</span>
                          <span class="mv-contact-val">{{ b_phone }}</span>
                        </div>
                      </a>
                    {%- endif -%}

                    {%- assign b_email = block.settings.email | default: contact_email -%}
                    {%- if b_email != blank -%}
                      <a href="mailto:{{ b_email }}" class="mv-contact-card" title="Email Concierge">
                        <div class="mv-contact-icon">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </div>
                        <div class="mv-contact-details">
                          <span class="mv-contact-label">Apothecary Support</span>
                          <span class="mv-contact-val">{{ b_email }}</span>
                        </div>
                      </a>
                    {%- endif -%}

                    {%- assign b_hours = block.settings.hours | default: contact_hours -%}
                    {%- if b_hours != blank -%}
                      <div class="mv-contact-card mv-contact-card--static">
                        <div class="mv-contact-icon">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <div class="mv-contact-details">
                          <span class="mv-contact-label">Ritual Concierge Hours</span>
                          <span class="mv-contact-val">{{ b_hours }}</span>
                        </div>
                      </div>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.show_social != false -%}
                    <div class="mv-footer-socials-wrap">
                      <span class="mv-socials-label">FOLLOW OUR JOURNEY</span>
                      <div class="mv-footer-socials">
                        {%- if social_ig != blank -%}
                          <a href="{{ social_ig }}" target="_blank" rel="noopener noreferrer" class="mv-social-btn" aria-label="Instagram">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                          </a>
                        {%- endif -%}
                        {%- if social_fb != blank -%}
                          <a href="{{ social_fb }}" target="_blank" rel="noopener noreferrer" class="mv-social-btn" aria-label="Facebook">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                          </a>
                        {%- endif -%}
                        {%- if social_yt != blank -%}
                          <a href="{{ social_yt }}" target="_blank" rel="noopener noreferrer" class="mv-social-btn" aria-label="YouTube">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
                          </a>
                        {%- endif -%}
                        {%- if social_tw != blank -%}
                          <a href="{{ social_tw }}" target="_blank" rel="noopener noreferrer" class="mv-social-btn" aria-label="Twitter X">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
                          </a>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'menu' -%}
                <div class="mv-footer-col mv-footer-col--links" {{ block.shopify_attributes }}>
                  <h3 class="mv-footer-heading">
                    <span class="mv-heading-star">✦</span>
                    {{ block.settings.title | default: 'QUICK LINKS' }}
                  </h3>
                  <nav class="mv-footer-menu" aria-label="{{ block.settings.title | default: 'Quick Links' }}">
                    {%- assign b_menu = block.settings.menu -%}
                    {%- assign b_links = b_menu.links -%}
                    {%- if b_links == blank or b_links.size == 0 -%}
                      {%- assign b_links = linklists[b_menu].links -%}
                    {%- endif -%}
                    {%- if b_links.size > 0 -%}
                      <ul class="mv-footer-nav-list">
                        {%- for link in b_links -%}
                          <li class="mv-nav-item">
                            <a href="{{ link.url }}" class="mv-nav-link">
                              <span class="mv-link-bullet">✦</span>
                              <span class="mv-link-text">{{ link.title }}</span>
                              <span class="mv-link-arrow">›</span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </nav>
                </div>

              {%- when 'newsletter' -%}
                <div class="mv-footer-col mv-footer-col--newsletter" {{ block.shopify_attributes }}>
                  <div class="mv-newsletter-podium">
                    <span class="mv-newsletter-kicker">{{ block.settings.kicker | default: '✦ THE INNER CIRCLE' }}</span>
                    <h3 class="mv-footer-heading mv-footer-heading--gold">
                      {{ block.settings.title | default: newsletter_title }}
                    </h3>
                    <p class="mv-newsletter-desc">
                      {{ block.settings.subtext | default: newsletter_subtext }}
                    </p>
                    <div class="mv-newsletter-form-box">
                      {%- form 'customer', id: 'mv-footer-newsletter-form-block', class: 'mv-newsletter-form' -%}
                        <input type="hidden" name="contact[tags]" value="newsletter,mv_insider_circle">
                        {%- if form.posted_successfully? -%}
                          <div class="mv-newsletter-success">
                            <span class="mv-success-star">✦</span>
                            <p class="mv-success-text">Welcome to the Inner Circle. Your invitation is on its way.</p>
                          </div>
                        {%- else -%}
                          <div class="mv-newsletter-capsule">
                            <div class="mv-capsule-input-wrap">
                              <svg class="mv-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                              <input 
                                type="email" 
                                name="contact[email]" 
                                id="mv-footer-email-block" 
                                class="mv-email-input" 
                                placeholder="Enter your email address"
                                required
                                autocomplete="email"
                                aria-label="Email address"
                              >
                            </div>
                            <button type="submit" class="mv-newsletter-btn" aria-label="Subscribe to newsletter">
                              <span class="mv-btn-shimmer"></span>
                              <span class="mv-btn-text">{{ block.settings.button_text | default: 'JOIN CIRCLE' }}</span>
                              <span class="mv-btn-icon">→</span>
                            </button>
                          </div>
                          {%- if form.errors -%}
                            <p class="mv-newsletter-error">
                              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                            </p>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endform -%}
                    </div>
                    <div class="mv-newsletter-perks">
                      <span class="mv-perk-item">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Spam-free assurance
                      </span>
                      <span class="mv-perk-item">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                        15% VIP welcome reward
                      </span>
                    </div>
                  </div>
                </div>

              {%- when 'text' -%}
                <div class="mv-footer-col mv-footer-col--text" {{ block.shopify_attributes }}>
                  <h3 class="mv-footer-heading">
                    <span class="mv-heading-star">✦</span>
                    {{ block.settings.title }}
                  </h3>
                  <div class="mv-footer-tagline">
                    {{ block.settings.content }}
                  </div>
                </div>

            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <!-- DEFAULT 4-COLUMN ARCHITECTURE (100% PRESERVED FALLBACK) -->
        <div class="mv-footer-grid">
          
          <!-- COLUMN 1: MAISON & HERITAGE -->
          <div class="mv-footer-col mv-footer-col--brand">
            <div class="mv-footer-brand-stage mv-brand-align--{{ brand_align }}">
              {%- if brand_logo != blank -%}
                <a href="{{ routes.root_url }}" class="mv-footer-logo-link" aria-label="{{ shop.name }}">
                  <picture>
                    {%- if mobile_brand_logo != blank -%}
                      <source media="(max-width: 767px)" srcset="{{ mobile_brand_logo | image_url: width: 400 }}">
                    {%- endif -%}
                    <img 
                      src="{{ brand_logo | image_url: width: 600 }}"
                      alt="{{ shop.name }}"
                      class="mv-footer-logo-img"
                      width="{{ section.settings.logo_width }}"
                      height="auto"
                      loading="lazy"
                    >
                  </picture>
                </a>
              {%- else -%}
                <a href="{{ routes.root_url }}" class="mv-footer-logo-fallback" aria-label="{{ shop.name }}">
                  <span class="mv-logo-emblem">✦</span>
                  <span class="mv-logo-text">MYRA VEDA</span>
                  <span class="mv-logo-subtext">LUXURY ESSENTIALS</span>
                </a>
              {%- endif -%}

              <div class="mv-gold-divider-subtle"></div>

              <p class="mv-footer-tagline">
                {%- if brand_tagline != blank -%}
                  {{ brand_tagline }}
                {%- else -%}
                  World's First Sustainable Clean-Beauty Brand. Handcrafted Ayurvedic formulations merging sacred Vedic herbs with European dermatological science.
                {%- endif -%}
              </p>

              <div class="mv-footer-creds">
                <span class="mv-cred-pill">✦ PETA Cruelty-Free</span>
                <span class="mv-cred-pill">✦ 100% Vegetarian</span>
                <span class="mv-cred-pill">✦ Sustainable Glass</span>
              </div>
            </div>
          </div>

          <!-- COLUMN 2: CONTACT US & CONCIERGE -->
          <div class="mv-footer-col mv-footer-col--contact">
            <h3 class="mv-footer-heading">
              <span class="mv-heading-star">✦</span>
              {{ contact_title }}
            </h3>
            
            <div class="mv-contact-items">
              <a href="tel:{{ contact_phone | replace: ' ', '' | replace: '-', '' }}" class="mv-contact-card" title="Call Concierge">
                <div class="mv-contact-icon">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </div>
                <div class="mv-contact-details">
                  <span class="mv-contact-label">Customer Care</span>
                  <span class="mv-contact-val">{{ contact_phone }}</span>
                </div>
              </a>

