{% schema %}
{
  "name": "MV Luxury Footer",
  "class": "mv-luxury-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Color Theme & Palette"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Footer Color Scheme",
      "options": [
        { "value": "pure_white_gold", "label": "Pure White & 24K Gold" },
        { "value": "cashmere_ivory", "label": "Cashmere Ivory & Gold" },
        { "value": "obsidian_gold", "label": "Royal Obsidian & Gold" },
        { "value": "custom", "label": "Custom Luxury Palette" }
      ],
      "default": "pure_white_gold"
    },
    {
      "type": "color",
