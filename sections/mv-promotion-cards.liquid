<div class="mv-promotions-section" id="mv-promotions-{{ section.id }}">
  <div class="mv-container">
    <div class="mv-section-header">
      {%- if section.settings.badge != blank -%}
        <span class="mv-section-badge">{{ section.settings.badge | escape }}</span>
      {%- endif -%}
      <h2 class="mv-section-title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="mv-section-subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      <div class="mv-divider-accent"></div>
    </div>

    <div class="mv-promo-grid">
      {%- for block in section.blocks -%}
        <div class="mv-promo-card" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.button_link | default: '#' }}" class="mv-promo-media-link" aria-label="{{ block.settings.title | escape }}">
            <div class="mv-promo-img-wrapper">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
                  sizes="(max-width: 749px) 90vw, (max-width: 1024px) 45vw, 380px"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  class="mv-promo-img"
                >
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'mv-promo-placeholder' }}
              {%- endif -%}
              <div class="mv-promo-gradient-scrim"></div>
            </div>
          </a>

          <div class="mv-promo-content">
            {%- if block.settings.caption != blank -%}
              <span class="mv-promo-tag">{{ block.settings.caption | escape }}</span>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="mv-promo-title">
                <a href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.title | escape }}</a>
              </h3>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <div class="mv-promo-btn-wrap">
                <a href="{{ block.settings.button_link | default: '#' }}" class="mv-btn-gold mv-promo-cta">
                  <span>{{ block.settings.button_label | escape }}</span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #mv-promotions-{{ section.id }} {
    padding: clamp(42px, 5vw, 62px) 24px;
    background: #FCFAF7;
    position: relative;
  }

  .mv-promo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .mv-promo-card {
    background: #FFFFFF;
    border-radius: 120px 120px 26px 26px;
    overflow: hidden;
    border: 1.5px solid rgba(201, 158, 62, 0.35);
    box-shadow: 0 16px 40px rgba(14, 40, 31, 0.06);
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mv-promo-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 24px 54px rgba(201, 158, 62, 0.22);
    border-color: #C99E3E;
  }

  .mv-promo-media-link {
    display: block;
    overflow: hidden;
    position: relative;
  }

  .mv-promo-img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 0.95;
    overflow: hidden;
    background: #F4EFEA;
    border-radius: 120px 120px 0 0;
  }

  .mv-promo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  .mv-promo-card:hover .mv-promo-img {
    transform: scale(1.07);
  }

  .mv-promo-gradient-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 65%, rgba(14, 40, 31, 0.35) 100%);
    pointer-events: none;
  }

  .mv-promo-content {
    padding: 32px 28px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    background: #FFFFFF;
  }

  .mv-promo-tag {
    display: inline-block;
    color: #8C651E;
    background: rgba(201, 158, 62, 0.08);
    border: 1px solid rgba(201, 158, 62, 0.4);
    padding: 6px 18px;
    border-radius: 50px;
    font-family: 'Cinzel', serif;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    margin-bottom: 14px;
  }

  .mv-promo-title {
    font-family: 'Marcellus', 'Playfair Display', Georgia, serif;
    font-size: 1.7rem;
    line-height: 1.28;
    margin: 0 0 20px;
    font-weight: 500;
    color: #0E281F;
  }

  .mv-promo-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .mv-promo-title a:hover {
    color: #C99E3E;
  }

  .mv-promo-btn-wrap {
    margin-top: auto;
    width: 100%;
  }

  .mv-promo-cta {
    width: 100%;
    padding: 14px 24px;
    font-family: 'Cinzel', serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    background: #0E281F;
    border: 1.5px solid #C99E3E;
    color: #FFFFFF !important;
  }

  .mv-promo-cta:hover {
    background: linear-gradient(135deg, #DFB76C 0%, #C59B45 42%, #9E7429 100%);
    color: #FFFFFF !important;
    border-color: #DFB76C;
  }

  @media (max-width: 990px) {
    .mv-promo-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    #mv-promotions-{{ section.id }} {
      padding: 34px 18px;
    }
    .mv-promo-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .mv-promo-card {
      border-radius: 90px 90px 22px 22px;
    }
    .mv-promo-img-wrapper {
      border-radius: 90px 90px 0 0;
    }
    .mv-promo-content {
      padding: 24px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "MV Promotion Cards",
  "tag": "section",
  "class": "mv-promotion-cards-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Curated Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Feel Good, Look Great"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Take solace in our wide RANGE of #CleanBeauty selection of cruelty-free skincare & haircare"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Category Tag",
          "default": "HAIRCARE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Healthy, Lustrous Hair"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "TRY THEM"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MV Promotion Cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
