<div class="mv-trust-section" id="mv-trust-{{ section.id }}" style="--trust-heading-desktop: {{ section.settings.heading_size_desktop | default: 34 }}px; --trust-heading-mobile: {{ section.settings.heading_size_mobile | default: 24 }}px; --trust-title-desktop: {{ section.settings.badge_title_size_desktop | default: 17 }}px; --trust-title-mobile: {{ section.settings.badge_title_size_mobile | default: 15 }}px; --trust-pt: {{ section.settings.padding_top | default: 52 }}px; --trust-pb: {{ section.settings.padding_bottom | default: 52 }}px; --trust-bg: {{ section.settings.background_color | default: '#FAF8F5' }};">
  <div class="mv-container">
    <!-- SECTION HEADER WITH LUXURY CAMEO CONTROLS -->
    <div class="mv-trust-header-row">
      <div class="mv-trust-title-col">
        {%- if section.settings.badge != blank -%}
          <span class="mv-section-badge">{{ section.settings.badge | escape }}</span>
        {%- endif -%}
        <h2 class="mv-section-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="mv-section-subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        <div class="mv-divider-accent"></div>
      </div>

      <!-- 24K GOLD WIREFRAME CAMEO ARROWS -->
      <div class="mv-trust-slider-nav">
        <button type="button" class="mv-trust-arrow mv-trust-prev" aria-label="Previous Badges" title="Previous Slide">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="mv-trust-arrow mv-trust-next" aria-label="Next Badges" title="Next Slide">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- TRUST BADGES SLIDER TRACK -->
    <div class="mv-trust-track-container mv-hide-scrollbar">
      <div class="mv-trust-track">
        {%- for block in section.blocks -%}
          <div class="mv-trust-card" {{ block.shopify_attributes }}>
            <div class="mv-card-gold-crest"></div>

            <div class="mv-trust-icon-ring">
              {%- if block.settings.image != blank -%}
                <picture>
                  {%- if block.settings.mobile_image != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 160 }}">
                  {%- endif -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 160 }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    class="mv-trust-img"
                    width="52"
                    height="52"
                  >
                </picture>
              {%- else -%}
                <div class="mv-trust-symbol">🌿</div>
              {%- endif -%}
            </div>

            <h3 class="mv-trust-title">{{ block.settings.title | escape }}</h3>
            <div class="mv-trust-divider"></div>
            <p class="mv-trust-caption">{{ block.settings.caption | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<style>
  #mv-trust-{{ section.id }} {
    padding-top: var(--trust-pt, clamp(42px, 5vw, 62px));
    padding-bottom: var(--trust-pb, clamp(42px, 5vw, 62px));
    padding-left: 24px;
    padding-right: 24px;
    background: var(--trust-bg, #FAF8F5);
    border-top: 1px solid rgba(201, 158, 62, 0.22);
    border-bottom: 1px solid rgba(201, 158, 62, 0.22);
    position: relative;
    overflow: hidden;
  }

  #mv-trust-{{ section.id }} .mv-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.2vw, 36px);
    box-sizing: border-box;
  }

  .mv-trust-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: clamp(24px, 3.5vw, 36px);
    gap: 20px;
    flex-wrap: wrap;
  }

  .mv-trust-title-col {
    max-width: 720px;
  }

  .mv-trust-title-col .mv-section-badge {
    display: inline-block;
    font-family: 'Cinzel', serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #8C651E;
    background: rgba(201, 158, 62, 0.1);
    border: 1px solid rgba(201, 158, 62, 0.4);
    padding: 4px 14px;
    border-radius: 999px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .mv-trust-title-col .mv-section-title {
    font-family: 'Marcellus', 'Playfair Display', Georgia, serif;
    font-size: var(--trust-heading-desktop, clamp(2rem, 3.5vw, 2.7rem));
    line-height: 1.18;
    color: #0E281F;
    margin: 0 0 8px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .mv-trust-title-col .mv-section-subtitle {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(0.88rem, 1.15vw, 0.98rem);
    color: #696054;
    line-height: 1.55;
    margin: 0 0 12px;
  }

  .mv-trust-title-col .mv-divider-accent {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, #DFB76C 0%, #AA7C11 100%);
    border-radius: 2px;
  }

  /* 24K GOLD WIREFRAME NAVIGATION BUTTONS */
  .mv-trust-slider-nav {
    display: flex;
    gap: 12px;
  }

  .mv-trust-arrow {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1.5px solid #C99E3E;
    color: #0E281F;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(14, 40, 31, 0.06);
    outline: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .mv-trust-arrow:hover {
    background: linear-gradient(135deg, #DFB76C 0%, #C59B45 50%, #9E7429 100%);
    color: #FFFFFF;
    border-color: #F5E8C7;
    box-shadow: 0 8px 24px rgba(201, 158, 62, 0.4);
    transform: scale(1.08);
  }

  .mv-trust-arrow:active {
    transform: scale(0.96);
  }

  /* SLIDER TRACK CONTAINER - ZERO PEEKING */
  .mv-trust-track-container {
    container-type: inline-size;
    container-name: trustcontainer;
    overflow: hidden;
    margin: 0;
    padding: 12px 0 28px 0;
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .mv-hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .mv-hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .mv-trust-track {
    display: flex;
    gap: 18px;
    width: max-content;
    transition: transform 0.55s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  /* LUXURY TRUST CARD - EXACTLY 4 CARDS ON DESKTOP */
  .mv-trust-card {
    flex: 0 0 calc((100% - 54px) / 4);
    width: calc((100% - 54px) / 4);
    flex: 0 0 calc((100cqw - 54px) / 4);
    width: calc((100cqw - 54px) / 4);
    max-width: calc((100cqw - 54px) / 4);
    min-width: calc((100cqw - 54px) / 4);
    background: linear-gradient(180deg, #FFFFFF 0%, #FCFAF7 100%);
    border: 1.5px solid rgba(201, 158, 62, 0.32);
    border-radius: 20px;
    padding: 30px 18px 26px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    box-shadow: 0 8px 24px rgba(14, 40, 31, 0.04), 0 2px 6px rgba(201, 158, 62, 0.04);
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .mv-card-gold-crest {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 2.5px;
    background: linear-gradient(90deg, transparent 0%, #C99E3E 50%, transparent 100%);
    border-radius: 999px;
  }

  .mv-trust-card:hover {
    transform: translateY(-8px);
    border-color: #C99E3E;
    box-shadow: 0 20px 48px rgba(14, 40, 31, 0.09), 0 0 0 1px rgba(201, 158, 62, 0.35);
  }

  .mv-trust-icon-ring {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: radial-gradient(circle, #FFFFFF 50%, #FBF7EE 100%);
    border: 1.5px solid #C99E3E;
    box-shadow: 0 0 0 5px rgba(201, 158, 62, 0.12), 0 8px 20px rgba(14, 40, 31, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    padding: 14px;
    transition: transform 0.4s ease, border-color 0.3s ease, box-shadow 0.4s ease;
    flex-shrink: 0;
  }

  .mv-trust-card:hover .mv-trust-icon-ring {
    transform: scale(1.08) rotate(3deg);
    border-color: #8C651E;
    box-shadow: 0 0 0 7px rgba(201, 158, 62, 0.22), 0 12px 26px rgba(14, 40, 31, 0.1);
  }

  .mv-trust-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mv-trust-symbol {
    font-size: 2.2rem;
  }

  .mv-trust-title {
    font-family: 'Marcellus', 'Playfair Display', Georgia, serif;
    font-size: var(--trust-title-desktop, 1.08rem);
    font-weight: 600;
    color: #0E281F;
    margin: 0 0 8px;
    line-height: 1.28;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .mv-trust-divider {
    width: 32px;
    height: 1.5px;
    background: linear-gradient(90deg, #DFB76C 0%, #AA7C11 100%);
    margin: 0 auto 12px;
    border-radius: 2px;
  }

  .mv-trust-caption {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.85rem;
    line-height: 1.58;
    color: #4A5550;
    margin: 0;
  }

  /* TABLET RESPONSIVENESS */
  @media (min-width: 768px) and (max-width: 1023px) {
    .mv-trust-card {
      flex: 0 0 calc((100cqw - 18px) / 2) !important;
      width: calc((100cqw - 18px) / 2) !important;
      max-width: calc((100cqw - 18px) / 2) !important;
      min-width: calc((100cqw - 18px) / 2) !important;
    }
  }

  /* MOBILE RESPONSIVENESS */
  @media (max-width: 767px) {
    #mv-trust-{{ section.id }} {
      padding-top: var(--trust-pt, clamp(34px, 6vw, 44px));
      padding-bottom: var(--trust-pb, clamp(34px, 6vw, 44px));
      padding-left: 0;
      padding-right: 0;
    }

    #mv-trust-{{ section.id }} .mv-container {
      padding: 0 16px;
    }

    .mv-trust-header-row {
      margin-bottom: 18px;
      gap: 14px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .mv-trust-title-col {
      max-width: calc(100% - 94px);
    }

    .mv-trust-title-col .mv-section-title {
      font-size: var(--trust-heading-mobile, 1.85rem);
    }

    .mv-trust-arrow {
      width: 38px;
      height: 38px;
    }

    .mv-trust-arrow svg {
      width: 15px;
      height: 15px;
    }

    .mv-trust-track-container {
      overflow-x: auto;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      margin: 0 -16px;
      padding: 8px 16px 22px 16px;
      -webkit-overflow-scrolling: touch;
    }

    .mv-trust-track {
      gap: 14px !important;
      transition: none !important;
      will-change: auto !important;
    }

    .mv-trust-card {
      flex: 0 0 82vw !important;
      width: 82vw !important;
      max-width: 310px !important;
      min-width: 270px !important;
      padding: 26px 18px 22px 18px !important;
      border-radius: 18px !important;
      scroll-snap-align: center !important;
    }

    .mv-trust-icon-ring {
      width: 74px;
      height: 74px;
      margin-bottom: 16px;
      padding: 12px;
    }

    .mv-trust-title {
      font-size: var(--trust-title-mobile, 1.05rem);
    }

    .mv-trust-caption {
      font-size: 0.84rem;
      line-height: 1.55;
    }
  }
</style>

<script>
  (function() {
    function initTrustSlider() {
      const wrap = document.getElementById('mv-trust-{{ section.id }}');
      if (!wrap) return;

      const trackContainer = wrap.querySelector('.mv-trust-track-container');
      const track = wrap.querySelector('.mv-trust-track');
      const cards = wrap.querySelectorAll('.mv-trust-card');
      const prevBtn = wrap.querySelector('.mv-trust-prev');
      const nextBtn = wrap.querySelector('.mv-trust-next');

      if (!trackContainer || !track || !cards.length) return;

      let currentIndex = 0;

      function getVisibleCount() {
        const w = window.innerWidth;
        if (w <= 767) return 1;
        if (w < 1024) return 2;
        return 4; // ALWAYS EXACTLY 4 CARDS ON DESKTOP!
      }

      function getGap() {
        const w = window.innerWidth;
        if (w <= 767) return 14;
        return 18;
      }

      function updateSlider() {
        const w = window.innerWidth;
        const isMobile = w <= 767;

        if (isMobile) {
          track.style.transform = 'none';
          track.style.gap = '14px';
          cards.forEach(c => {
            c.style.removeProperty('width');
            c.style.removeProperty('flex');
            c.style.removeProperty('max-width');
            c.style.removeProperty('min-width');
          });
          return;
        }

        const visibleCount = getVisibleCount();
        const gap = getGap();
        const containerWidth = trackContainer.getBoundingClientRect().width;
        const totalGaps = gap * (visibleCount - 1);
        const cardWidth = (containerWidth - totalGaps) / visibleCount;

        cards.forEach(c => {
          const wPx = cardWidth.toFixed(2) + 'px';
          c.style.width = wPx;
          c.style.flex = '0 0 ' + wPx;
          c.style.maxWidth = wPx;
          c.style.minWidth = wPx;
        });

        track.style.gap = gap + 'px';
        const maxIndex = Math.max(0, cards.length - visibleCount);
        if (currentIndex > maxIndex) currentIndex = maxIndex;
        const offset = currentIndex * (cardWidth + gap);
        track.style.transform = 'translateX(-' + offset.toFixed(2) + 'px)';
      }

      updateSlider();

      window.removeEventListener('resize', updateSlider);
      window.addEventListener('resize', updateSlider, { passive: true });

      if (prevBtn) {
        prevBtn.onclick = function(e) {
          e.preventDefault();
          const w = window.innerWidth;
          if (w <= 767) {
            const card = trackContainer.querySelector('.mv-trust-card');
            const step = card ? card.offsetWidth + 14 : 300;
            trackContainer.scrollBy({ left: -step, behavior: 'smooth' });
          } else {
            const visibleCount = getVisibleCount();
            const maxIndex = Math.max(0, cards.length - visibleCount);
            currentIndex = (currentIndex <= 0) ? maxIndex : (currentIndex - 1);
            updateSlider();
          }
        };
      }

      if (nextBtn) {
        nextBtn.onclick = function(e) {
          e.preventDefault();
          const w = window.innerWidth;
          if (w <= 767) {
            const card = trackContainer.querySelector('.mv-trust-card');
            const step = card ? card.offsetWidth + 14 : 300;
            trackContainer.scrollBy({ left: step, behavior: 'smooth' });
          } else {
            const visibleCount = getVisibleCount();
            const maxIndex = Math.max(0, cards.length - visibleCount);
            currentIndex = (currentIndex >= maxIndex) ? 0 : (currentIndex + 1);
            updateSlider();
          }
        };
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTrustSlider);
    } else {
      initTrustSlider();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (!e.target || e.target.contains(document.getElementById('mv-trust-{{ section.id }}'))) {
        initTrustSlider();
      }
    });

    document.addEventListener('shopify:section:select', function(e) {
      if (!e.target || e.target.contains(document.getElementById('mv-trust-{{ section.id }}'))) {
        initTrustSlider();
      }
    });
  })();
</script>

