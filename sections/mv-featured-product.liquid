<div class="mv-featured-prod-section" id="mv-feat-prod-{{ section.id }}">
  <div class="mv-container">
    <div class="mv-section-header">
      {%- if section.settings.badge != blank -%}
        <span class="mv-section-badge">{{ section.settings.badge | escape }}</span>
      {%- endif -%}
      <h2 class="mv-section-title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="mv-section-subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      <div class="mv-divider-accent"></div>
    </div>

    {%- assign product = all_products[section.settings.product] -%}

    <div class="mv-prod-spotlight-card">
      <div class="mv-prod-split">
        {%- comment -%} Media Gallery {%- endcomment -%}
        <div class="mv-prod-gallery">
          <div class="mv-prod-main-image-wrap">
            {%- if product != blank and product.featured_media != blank -%}
              <img
                src="{{ product.featured_media | image_url: width: 1000 }}"
                srcset="{{ product.featured_media | image_url: width: 500 }} 500w, {{ product.featured_media | image_url: width: 900 }} 900w"
                sizes="(max-width: 990px) 100vw, 550px"
                alt="{{ product.title | escape }}"
                loading="lazy"
                class="mv-prod-main-img"
              >
            {%- else -%}
              {{ 'product-3' | placeholder_svg_tag: 'mv-prod-placeholder' }}
            {%- endif -%}
            <span class="mv-spotlight-badge">SIGNATURE FORMULA</span>
          </div>
        </div>

        {%- comment -%} Product Details & Purchase {%- endcomment -%}
        <div class="mv-prod-details">
          <div class="mv-rating-stars">
            <span>★★★★★</span>
            <span class="mv-rating-text">4.9 / 5.0 (2,400+ Reviews)</span>
          </div>

          <h3 class="mv-spotlight-title">
            {%- if product != blank -%}
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            {%- else -%}
              Amazonian White Clay from Egypt
            {%- endif -%}
          </h3>

          <div class="mv-spotlight-price-row">
            {%- if product != blank -%}
              <span class="mv-price-val">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="mv-compare-val">{{ product.compare_at_price | money }}</span>
                <span class="mv-save-badge">Save {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span>
              {%- endif -%}
            {%- else -%}
              <span class="mv-price-val">₹1,150.00</span>
              <span class="mv-compare-val">₹1,450.00</span>
              <span class="mv-save-badge">Save 21%</span>
            {%- endif -%}
          </div>

          <div class="mv-spotlight-desc">
            {%- if product != blank and product.description != blank -%}
              {{ product.description | truncatewords: 35 }}
            {%- else -%}
              Enriched with deep-pore clarifying minerals from the banks of the Nile, combined with Ayurvedic detoxifying herbs to illuminate, tighten, and nourish your complexion naturally.
            {%- endif -%}
          </div>

          <div class="mv-benefits-checklist">
            <div class="mv-check-item">
              <span class="mv-check-halo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C99E3E" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span>Draws out deep micro-toxins & excess sebum without stripping moisture</span>
            </div>
            <div class="mv-check-item">
              <span class="mv-check-halo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C99E3E" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span>Infused with authentic Egyptian White Clay & healing botanical extracts</span>
            </div>
            <div class="mv-check-item">
              <span class="mv-check-halo">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C99E3E" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <span>100% vegetarian, free from 400+ harsh chemicals</span>
            </div>
          </div>

          {%- comment -%} Purchase Form {%- endcomment -%}
          {%- if product != blank and product.available -%}
            <form method="post" action="/cart/add" class="mv-prod-form">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <div class="mv-form-actions">
                <button type="submit" class="mv-btn-gold mv-btn-full">
                  <span>Add To Bag</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                </button>
              </div>
            </form>
          {%- else -%}
            <div class="mv-form-actions">
              <a href="{{ product.url | default: '/collections/all' }}" class="mv-btn-gold mv-btn-full">
                <span>View Product Details</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
              </a>
            </div>
          {%- endif -%}

          {%- comment -%} Goes Well With Cross-Sell {%- endcomment -%}
          {%- assign cross_prod = all_products[section.settings.cross_sell_product] -%}
          {%- if cross_prod != blank or section.settings.cross_sell_product != blank -%}
            <div class="mv-cross-sell-box">
              <span class="mv-cross-label">✦ Goes Best With:</span>
              <div class="mv-cross-content">
                {%- if cross_prod != blank and cross_prod.featured_media != blank -%}
                  <img src="{{ cross_prod.featured_media | image_url: width: 120 }}" alt="{{ cross_prod.title | escape }}" class="mv-cross-thumb">
                {%- else -%}
                  <div class="mv-cross-placeholder">🌹</div>
                {%- endif -%}
                <div class="mv-cross-info">
                  <strong>{{ cross_prod.title | default: "Pure Rose Water (100ml)" }}</strong>
                  <span>Mix with clay mask for the ultimate royal glow</span>
                </div>
                <a href="{{ cross_prod.url | default: '/products/myra-veda-pure-rose-water-100ml' }}" class="mv-cross-btn">Add</a>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #mv-feat-prod-{{ section.id }} {
    padding: clamp(42px, 5vw, 62px) 24px;
    background: #FAF8F5;
    border-top: 1px solid rgba(201, 158, 62, 0.2);
    border-bottom: 1px solid rgba(201, 158, 62, 0.2);
  }

  .mv-prod-spotlight-card {
    background: #FFFFFF;
    border-radius: 28px;
    border: 1px solid rgba(201, 158, 62, 0.28);
    box-shadow: 0 16px 44px rgba(14, 40, 31, 0.05);
    padding: clamp(32px, 4.5vw, 56px);
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
  }

  .mv-prod-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(36px, 5.5vw, 68px);
    align-items: center;
  }

  .mv-prod-gallery {
    position: relative;
  }

  .mv-prod-main-image-wrap {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    background: #F8F5EE;
    border: 1.5px solid rgba(201, 158, 62, 0.3);
    box-shadow: 0 12px 32px rgba(14, 40, 31, 0.06);
    aspect-ratio: 0.95;
  }

  .mv-prod-main-img,
  .mv-prod-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mv-prod-main-image-wrap:hover .mv-prod-main-img {
    transform: scale(1.04);
  }

  .mv-spotlight-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    background: #0E281F;
    color: #F5E8C7;
    border: 1.5px solid #C99E3E;
    font-family: 'Cinzel', serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: var(--mv-radius-pill);
    box-shadow: 0 4px 16px rgba(14, 40, 31, 0.4);
    z-index: 2;
  }

  .mv-prod-details {
    display: flex;
    flex-direction: column;
  }

  .mv-rating-text {
    font-family: var(--mv-font-sans);
    font-size: 0.84rem;
    color: #7E766D;
    margin-left: 8px;
    font-weight: 600;
  }

  .mv-spotlight-title {
    font-family: 'Marcellus', 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 3.2vw, 2.7rem);
    color: #0E281F;
    line-height: 1.2;
    margin: 14px 0 16px;
    font-weight: 500;
  }

  .mv-spotlight-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .mv-spotlight-title a:hover {
    color: #C99E3E;
  }

  .mv-spotlight-price-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .mv-price-val {
    font-family: var(--mv-font-sans);
    font-size: 1.6rem;
    font-weight: 700;
    color: #0E281F;
  }

  .mv-compare-val {
    font-family: var(--mv-font-sans);
    font-size: 1.1rem;
    color: #9C958D;
    text-decoration: line-through;
  }

  .mv-save-badge {
    background: rgba(201, 158, 62, 0.14);
    color: #8C651E;
    font-family: var(--mv-font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--mv-radius-pill);
    border: 1px solid rgba(201, 158, 62, 0.3);
  }

  .mv-spotlight-desc {
    font-family: var(--mv-font-sans);
    font-size: 0.96rem;
    line-height: 1.7;
    color: #4A5550;
    margin-bottom: 26px;
  }

  .mv-benefits-checklist {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 30px;
  }

  .mv-check-item {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--mv-font-sans);
    font-size: 0.9rem;
    color: #242D28;
    line-height: 1.45;
  }

  .mv-check-halo {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #FBF7EE;
    border: 1.5px solid #C99E3E;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(201, 158, 62, 0.18);
  }

  .mv-btn-full {
    width: 100%;
  }

  .mv-cross-sell-box {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid rgba(201, 158, 62, 0.22);
  }

  .mv-cross-label {
    display: block;
    font-family: var(--mv-font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #8C651E;
    margin-bottom: 14px;
  }

  .mv-cross-content {
    background: #FCFAF7;
    border-radius: 18px;
    border: 1px solid rgba(201, 158, 62, 0.28);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 4px 14px rgba(14, 40, 31, 0.03);
  }

  .mv-cross-thumb {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    object-fit: cover;
    border: 1px solid rgba(201, 158, 62, 0.25);
  }

  .mv-cross-placeholder {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    background: #FFFFFF;
    border: 1px solid rgba(201, 158, 62, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
  }

  .mv-cross-info {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .mv-cross-info strong {
    font-family: var(--mv-font-sans);
    font-size: 0.9rem;
    color: #0E281F;
    font-weight: 700;
  }

  .mv-cross-info span {
    font-family: var(--mv-font-sans);
    font-size: 0.78rem;
    color: #7E766D;
  }

  .mv-cross-btn {
    padding: 9px 20px;
    background: #0E281F;
    border: 1.5px solid #C99E3E;
    border-radius: var(--mv-radius-pill);
    color: #F5E8C7;
    font-family: var(--mv-font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(14, 40, 31, 0.15);
  }

  .mv-cross-btn:hover {
    background: var(--mv-gold-gradient);
    color: #FFFFFF;
    border-color: transparent;
    box-shadow: 0 6px 18px rgba(201, 158, 62, 0.38);
  }

  @media (max-width: 990px) {
    .mv-prod-split {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 640px) {
    #mv-feat-prod-{{ section.id }} {
      padding: 34px 18px;
    }
    .mv-prod-spotlight-card {
      padding: 24px 18px;
      border-radius: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "MV Featured Product",
  "tag": "section",
  "class": "mv-featured-product-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Signature Formulation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mask Like Never Before!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "One of our best sellers ever!"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product"
    },
    {
      "type": "product",
      "id": "cross_sell_product",
      "label": "Goes Well With Product"
    }
  ],
  "presets": [
    {
      "name": "MV Featured Product"
    }
  ]
}
{% endschema %}
