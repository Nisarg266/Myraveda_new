{%- doc -%}
  Renders a luxury Ayurvedic & Clean Beauty Trust Strip block for Myra Veda product pages.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign badge_style = block_settings.badge_style | default: 'pills'
-%}

<div
  class="mv-product-trust-badges mv-badge-style--{{ badge_style }}"
  style="
    --mv-badge-bg: {{ block_settings.bg_color | default: '#FAF8F5' }};
    --mv-badge-border: {{ block_settings.border_color | default: 'rgba(201, 158, 62, 0.35)' }};
    --mv-badge-text: {{ block_settings.text_color | default: '#0E281F' }};
    --mv-badge-gold: {{ block_settings.gold_color | default: '#C99E3E' }};
    margin-top: {{ block_settings.margin_top | default: 16 }}px;
    margin-bottom: {{ block_settings.margin_bottom | default: 16 }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if block_settings.heading != blank -%}
    <div class="mv-trust-badges-heading">
      <span class="mv-trust-star">✦</span>
      <span class="mv-trust-heading-text">{{ block_settings.heading }}</span>
    </div>
  {%- endif -%}

  <div class="mv-trust-badges-grid">
    {%- if block_settings.badge_1_text != blank -%}
      <div class="mv-trust-badge-item">
        <span class="mv-trust-badge-icon">
          {%- case block_settings.badge_1_icon -%}
            {%- when 'leaf' -%}🍃
            {%- when 'sparkle' -%}✦
            {%- when 'shield' -%}🛡️
            {%- when 'heart' -%}💚
            {%- when 'check' -%}✓
            {%- else -%}✦
          {%- endcase -%}
        </span>
        <div class="mv-trust-badge-content">
          <span class="mv-trust-badge-title">{{ block_settings.badge_1_text }}</span>
          {%- if block_settings.badge_1_sub != blank -%}
            <span class="mv-trust-badge-sub">{{ block_settings.badge_1_sub }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if block_settings.badge_2_text != blank -%}
      <div class="mv-trust-badge-item">
        <span class="mv-trust-badge-icon">
          {%- case block_settings.badge_2_icon -%}
            {%- when 'leaf' -%}🍃
            {%- when 'sparkle' -%}✦
            {%- when 'shield' -%}🛡️
            {%- when 'heart' -%}💚
            {%- when 'check' -%}✓
            {%- else -%}🍃
          {%- endcase -%}
        </span>
        <div class="mv-trust-badge-content">
          <span class="mv-trust-badge-title">{{ block_settings.badge_2_text }}</span>
          {%- if block_settings.badge_2_sub != blank -%}
            <span class="mv-trust-badge-sub">{{ block_settings.badge_2_sub }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if block_settings.badge_3_text != blank -%}
      <div class="mv-trust-badge-item">
        <span class="mv-trust-badge-icon">
          {%- case block_settings.badge_3_icon -%}
            {%- when 'leaf' -%}🍃
            {%- when 'sparkle' -%}✦
            {%- when 'shield' -%}🛡️
            {%- when 'heart' -%}💚
            {%- when 'check' -%}✓
            {%- else -%}🛡️
          {%- endcase -%}
        </span>
        <div class="mv-trust-badge-content">
          <span class="mv-trust-badge-title">{{ block_settings.badge_3_text }}</span>
          {%- if block_settings.badge_3_sub != blank -%}
            <span class="mv-trust-badge-sub">{{ block_settings.badge_3_sub }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if block_settings.badge_4_text != blank -%}
      <div class="mv-trust-badge-item">
        <span class="mv-trust-badge-icon">
          {%- case block_settings.badge_4_icon -%}
            {%- when 'leaf' -%}🍃
            {%- when 'sparkle' -%}✦
            {%- when 'shield' -%}🛡️
            {%- when 'heart' -%}💚
            {%- when 'check' -%}✓
            {%- else -%}✓
          {%- endcase -%}
        </span>
        <div class="mv-trust-badge-content">
          <span class="mv-trust-badge-title">{{ block_settings.badge_4_text }}</span>
          {%- if block_settings.badge_4_sub != blank -%}
            <span class="mv-trust-badge-sub">{{ block_settings.badge_4_sub }}</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Ayurvedic Trust Badges",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "VEDIC CLEAN-BEAUTY STANDARDS"
    },
    {
      "type": "select",
      "id": "badge_style",
      "label": "Badge Display Style",
      "options": [
        { "value": "pills", "label": "Luxury Rounded Pills" },
        { "value": "cards", "label": "Mini Velvet Cards" },
        { "value": "minimal", "label": "Minimal Clean Grid" }
      ],
      "default": "pills"
    },
    {
      "type": "header",
      "content": "Badge 1: Vegetarian Standard"
    },
    {
      "type": "select",
      "id": "badge_1_icon",
      "label": "Badge 1 Icon",
      "options": [
        { "value": "sparkle", "label": "Gold Sparkle (✦)" },
        { "value": "leaf", "label": "Botanical Leaf (🍃)" },
        { "value": "shield", "label": "Purity Shield (🛡️)" },
        { "value": "heart", "label": "Cruelty-Free Heart (💚)" },
        { "value": "check", "label": "Checkmark (✓)" }
      ],
      "default": "leaf"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Title",
      "default": "100% Vegetarian"
    },
    {
      "type": "text",
      "id": "badge_1_sub",
      "label": "Badge 1 Subtitle",
      "default": "Plant-powered Vedic alchemy"
    },
    {
      "type": "header",
      "content": "Badge 2: Cruelty-Free Standard"
    },
    {
      "type": "select",
      "id": "badge_2_icon",
      "label": "Badge 2 Icon",
      "options": [
        { "value": "sparkle", "label": "Gold Sparkle (✦)" },
        { "value": "leaf", "label": "Botanical Leaf (🍃)" },
        { "value": "shield", "label": "Purity Shield (🛡️)" },
        { "value": "heart", "label": "Cruelty-Free Heart (💚)" },
        { "value": "check", "label": "Checkmark (✓)" }
      ],
      "default": "heart"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Title",
      "default": "PETA Cruelty-Free"
    },
    {
      "type": "text",
      "id": "badge_2_sub",
      "label": "Badge 2 Subtitle",
      "default": "Never tested on animals"
    },
    {
      "type": "header",
      "content": "Badge 3: Chemical Free"
    },
    {
      "type": "select",
      "id": "badge_3_icon",
      "label": "Badge 3 Icon",
      "options": [
        { "value": "sparkle", "label": "Gold Sparkle (✦)" },
        { "value": "leaf", "label": "Botanical Leaf (🍃)" },
        { "value": "shield", "label": "Purity Shield (🛡️)" },
        { "value": "heart", "label": "Cruelty-Free Heart (💚)" },
        { "value": "check", "label": "Checkmark (✓)" }
      ],
      "default": "shield"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 Title",
      "default": "Zero Toxins & Parabens"
    },
    {
      "type": "text",
      "id": "badge_3_sub",
      "label": "Badge 3 Subtitle",
      "default": "Free of 400+ harmful chemicals"
    },
    {
      "type": "header",
      "content": "Badge 4: Authentic Ayurvedic Science"
    },
    {
      "type": "select",
      "id": "badge_4_icon",
      "label": "Badge 4 Icon",
      "options": [
        { "value": "sparkle", "label": "Gold Sparkle (✦)" },
        { "value": "leaf", "label": "Botanical Leaf (🍃)" },
        { "value": "shield", "label": "Purity Shield (🛡️)" },
        { "value": "heart", "label": "Cruelty-Free Heart (💚)" },
        { "value": "check", "label": "Checkmark (✓)" }
      ],
      "default": "sparkle"
    },
    {
      "type": "text",
      "id": "badge_4_text",
      "label": "Badge 4 Title",
      "default": "Dermatologist Tested"
    },
    {
      "type": "text",
      "id": "badge_4_sub",
      "label": "Badge 4 Subtitle",
      "default": "Gentle & proven formulations"
    },
    {
      "type": "header",
      "content": "Styling & Margins"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Badge Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "border_color",
